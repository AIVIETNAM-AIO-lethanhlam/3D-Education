<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Admin/AdminPage.uss"/>

    <!-- Notifications for students / teachers (2026-09). Built by NotificationPageController. -->
    <ui:VisualElement name="notification-root" class="adm-root">
        <ui:VisualElement name="notification-main" class="adm-main"/>
        <ui:VisualElement name="notification-overlay-layer" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
    </ui:VisualElement>
</ui:UXML>
