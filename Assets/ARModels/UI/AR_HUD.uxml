<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <!-- Dùng đường dẫn tương đối gọi file USS cùng thư mục -->
    <Style src="AR_HUD.uss" />
    
    <engine:VisualElement name="root" class="root-container">
        <!-- Top Bar -->
        <engine:VisualElement name="top-bar" class="top-bar">
            <!-- Nút Back -->
            <engine:Button name="back-button" class="back-btn">
                <engine:VisualElement class="btn-icon icon-back" />
            </engine:Button>

            <!-- Nút Menu -->
            <engine:Button name="menu-button" class="menu-btn">
                <engine:VisualElement class="btn-icon icon-menu" />
            </engine:Button>
        </engine:VisualElement>

        <!-- Menu Panel chứa các nút con -->
        <engine:VisualElement name="menu-panel" class="menu-panel hidden">
            <engine:Button name="toggle-visibility-btn" class="sub-menu-btn">
                <engine:VisualElement name="visibility-icon" class="btn-icon" />
            </engine:Button>

            <engine:Button name="toggle-rotate-btn" class="sub-menu-btn">
                <engine:VisualElement name="rotate-icon" class="btn-icon" />
            </engine:Button>

            <engine:Button name="model-list-btn" class="sub-menu-btn">
                <engine:VisualElement name="model-list-icon" class="btn-icon" />
            </engine:Button>
        </engine:VisualElement>

        <!-- Pop-up Danh Sách Mô Hình -->
        <engine:VisualElement name="model-popup" class="popup-overlay hidden">
            <engine:VisualElement class="popup-card">
                <engine:VisualElement class="popup-header">
                    <engine:Label text="Danh Sách Mô Hình 3D" class="popup-title" />
                    <engine:Button name="close-popup-btn" class="popup-close-btn">
                        <engine:Label text="X" class="popup-close-text" />
                    </engine:Button>
                </engine:VisualElement>

                <engine:ScrollView name="model-scroll-view" class="model-scroll-view">
                    <engine:VisualElement name="model-list-container" />
                </engine:ScrollView>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>