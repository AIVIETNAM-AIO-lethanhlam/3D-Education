.create-class-page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(247, 249, 253);
    color: rgb(12, 30, 67);
}

/* HEADER */
.wizard-header {
    width: 100%;
    height: 142px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 32px;
    padding-bottom: 16px;
    flex-shrink: 0;
    background-color: white;
    border-bottom-width: 1px;
    border-bottom-color: rgb(231, 235, 244);
}

.header-main-row {
    width: 100%;
    height: 66px;
    flex-direction: row;
    align-items: center;
}

.header-back-button {
    width: 40px;
    min-width: 40px;
    height: 40px;
    margin-right: 8px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(242, 246, 255);
    border-width: 0;
    border-radius: 20px;
}

.header-back-button:hover { background-color: rgb(229, 237, 252); }

.back-icon {
    width: 18px;
    height: 18px;
    background-image: url("project://database/Assets/UI/Images/Icons/back.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(15, 38, 77);
}

.header-title-group {
    flex-grow: 1;
    justify-content: center;
}

.step-label {
    margin-bottom: 1px;
    font-size: 13px;
    color: rgb(76, 98, 139);
}

.page-title-label {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(8, 28, 66);
}

.cancel-button {
    width: 60px;
    min-width: 60px;
    height: 36px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    font-size: 13px;
    color: rgb(60, 83, 126);
}

.progress-row {
    width: 100%;
    height: 7px;
    margin-top: 8px;
    flex-direction: row;
}

.progress-segment {
    height: 7px;
    flex-grow: 1;
    margin-right: 7px;
    background-color: rgb(230, 237, 249);
    border-radius: 4px;
}

.progress-segment-end { margin-right: 0; }
.progress-segment-active { background-color: rgb(0, 75, 181); }

/* BODY */
.body-container {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(247, 249, 253);
}

.step-panel {
    width: 100%;
    height: 100%;
}

.clean-scroll .unity-scroller--vertical,
.clean-scroll .unity-scroller--horizontal {
    display: none;
}

.clean-scroll .unity-scroll-view__content-viewport {
    padding: 0;
}

.form-content {
    width: 100%;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 28px;
    padding-bottom: 34px;
}

.branding-content { padding-top: 25px; }

.form-label {
    margin-bottom: 9px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(70, 94, 138);
}

.form-label-spacing { margin-top: 20px; }

/* INPUTS */
.form-input {
    width: 100%;
    height: 54px;
    background-color: white;
    border-width: 1px;
    border-color: rgb(220, 226, 238);
    border-radius: 17px;
}

.form-input .unity-base-field__input,
.form-input .unity-text-input {
    height: 52px;
    padding-left: 17px;
    padding-right: 17px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 15px;
    color: rgb(22, 43, 82);
}

.form-input:hover,
.form-input:focus {
    border-color: rgb(220, 226, 238);
}


/* CUSTOM VISIBILITY DROPDOWN */
.custom-visibility-dropdown {
    width: auto;
    align-self: stretch;

    margin-left: 2px;
    margin-right: 0;

    position: relative;
    overflow: visible;
}

.custom-visibility-button {
    width: auto;
    align-self: stretch;
    height: 56px;
    min-height: 56px;

    padding-left: 18px;
    padding-right: 16px;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    background-color: rgb(255, 255, 255);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(216, 225, 240);
    border-right-color: rgb(216, 225, 240);
    border-top-color: rgb(216, 225, 240);
    border-bottom-color: rgb(216, 225, 240);

    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.custom-visibility-button:hover {
    background-color: rgb(249, 252, 255);

    border-left-color: rgb(170, 195, 232);
    border-right-color: rgb(170, 195, 232);
    border-top-color: rgb(170, 195, 232);
    border-bottom-color: rgb(170, 195, 232);
}

.custom-visibility-button-open {
    background-color: rgb(255, 255, 255);

    border-left-color: rgb(93, 135, 207);
    border-right-color: rgb(93, 135, 207);
    border-top-color: rgb(93, 135, 207);
    border-bottom-color: rgb(216, 225, 240);

    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.custom-visibility-selected-label {
    flex-grow: 1;

    font-size: 15px;
    color: rgb(94, 112, 148);

    -unity-text-align: middle-left;
}

.custom-visibility-selected-label-active {
    color: rgb(25, 49, 91);
    -unity-font-style: bold;
}

.custom-visibility-arrow {
    width: 18px;
    height: 18px;

    margin-left: auto;

    background-image: url("project://database/Assets/UI/Images/Icons/drop-down.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(62, 91, 145);
}

.custom-visibility-arrow-open {
    rotate: 180deg;
}

.custom-visibility-options {
    width: auto;
    align-self: stretch;

    margin-left: 0;
    margin-right: 0;
    margin-top: -1px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;

    background-color: rgb(255, 255, 255);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 1px;

    border-left-color: rgb(93, 135, 207);
    border-right-color: rgb(93, 135, 207);
    border-bottom-color: rgb(93, 135, 207);

    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.custom-visibility-option {
    width: 100%;
    min-height: 58px;

    padding-left: 11px;
    padding-right: 11px;
    padding-top: 8px;
    padding-bottom: 8px;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    background-color: transparent;
    border-width: 0;

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.custom-visibility-option:hover {
    background-color: rgb(240, 246, 255);
}

.custom-visibility-option-selected {
    background-color: rgb(231, 240, 255);
}

.custom-visibility-option-icon {
    width: 34px;
    min-width: 34px;
    height: 34px;
    margin-right: 11px;

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;

    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.visibility-public-icon {
    background-color: rgb(230, 248, 238);
    background-image: url("project://database/Assets/UI/Images/Icons/world-wide-web.png");
    -unity-background-image-tint-color: rgb(28, 153, 88);
}

.visibility-private-icon {
    background-color: rgb(255, 237, 239);
    background-image: url("project://database/Assets/UI/Images/Icons/lock.png");
    -unity-background-image-tint-color: rgb(207, 61, 77);
}

.custom-visibility-option-text-group {
    flex-grow: 1;

    align-items: flex-start;
    justify-content: center;
}

.custom-visibility-option-title {
    width: 100%;

    margin-bottom: 2px;

    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(23, 45, 83);

    -unity-text-align: middle-left;
}

.custom-visibility-option-description {
    width: 100%;

    white-space: normal;

    font-size: 10px;
    color: rgb(102, 119, 151);

    -unity-text-align: middle-left;
}

.custom-visibility-divider {
    width: auto;
    height: 1px;
    margin-left: 50px;
    margin-right: 8px;
    background-color: rgb(235, 239, 247);
}



/* CUSTOM CATEGORY DROPDOWN */
.category-options-panel {
    max-height: 250px;

    padding-top: 6px;
    padding-bottom: 6px;

    overflow: hidden;
}

.category-options-scroll {
    width: 100%;
    max-height: 236px;
}

.category-options-scroll .unity-scroll-view__vertical-scroller {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
}

.category-options-scroll .unity-scroller__low-button,
.category-options-scroll .unity-scroller__high-button,
.category-options-scroll .unity-scroller__slider,
.category-options-scroll .unity-scroller__tracker,
.category-options-scroll .unity-scroller__dragger {
    display: none;
}

.category-options-container {
    width: 100%;
}

.category-state-label {
    width: 100%;
    min-height: 42px;

    padding-left: 14px;
    padding-right: 14px;

    color: rgb(102, 119, 151);
    font-size: 12px;

    -unity-text-align: middle-left;
}

.custom-category-option {
    width: 100%;
    min-height: 44px;

    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;

    align-items: center;
    justify-content: flex-start;

    background-color: transparent;

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;

    color: rgb(23, 45, 83);
    font-size: 14px;

    -unity-text-align: middle-left;
}

.custom-category-option:hover {
    background-color: rgb(240, 246, 255);
    color: rgb(25, 79, 174);
}

.custom-category-option-selected {
    background-color: rgb(231, 240, 255);
    color: rgb(20, 75, 169);
    -unity-font-style: bold;
}

.custom-category-divider {
    width: auto;
    height: 1px;

    margin-left: 12px;
    margin-right: 12px;

    background-color: rgb(235, 239, 247);
}

/* STEP 2 */
.upload-cover-button {
    width: 100%;
    height: 176px;
    padding: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(247, 249, 253);
    border-width: 2px;
    border-color: rgb(139, 160, 196);
    border-radius: 18px;
}

.upload-cover-button:hover {
    background-color: rgb(240, 245, 254);
    border-color: rgb(0, 82, 195);
}

.upload-content {
    align-items: center;
    justify-content: center;
}

.upload-icon-text {
    width: 38px;
    height: 38px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    font-size: 31px;
    -unity-font-style: bold;
    color: rgb(77, 103, 150);
}

.upload-title {
    margin-bottom: 6px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(10, 30, 68);
}

.upload-description {
    font-size: 13px;
    color: rgb(76, 99, 141);
}

.selected-cover-preview {
    width: 100%;
    height: 176px;
    position: relative;
    overflow: hidden;
    border-radius: 18px;
}

.selected-cover-image {
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-and-crop;
}

.remove-cover-button {
    width: 82px;
    height: 34px;
    position: absolute;
    right: 10px;
    top: 10px;
    background-color: rgba(255,255,255,0.94);
    border-width: 0;
    border-radius: 17px;
    font-size: 13px;
    color: rgb(180, 34, 45);
}

.template-heading { margin-top: 21px; }

.template-scroll-view {
    width: 100%;
    height: 68px;
}

.template-scroll-view .unity-scroll-view__content-viewport {
    height: 68px;
    overflow: hidden;
}

.template-scroll-view .unity-scroll-view__content-container {
    height: 68px;
    flex-direction: row;
}

.template-scroll-view .unity-scroller--vertical,
.template-scroll-view .unity-scroller--horizontal {
    display: none;
}

.template-custom-scrollbar {
    width: 100%;
    height: 8px;
    margin-top: 4px;
    flex-direction: row;
    align-items: center;
}

.template-scroll-arrow {
    width: 10px;
    min-width: 10px;
    height: 8px;
    min-height: 8px;
    padding: 0;
    margin: 0;
    background-color: rgb(225, 225, 225);
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(115, 115, 115);
    border-width: 0;
    border-radius: 0;
}

.template-scroll-arrow-left {
    background-image: url("project://database/Assets/UI/Images/CreateClass/scroll-arrow-left.png");
}

.template-scroll-arrow-right {
    background-image: url("project://database/Assets/UI/Images/CreateClass/scroll-arrow-right.png");
}

.template-scroll-track {
    height: 8px;
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(48, 48, 48);
}

.template-scroll-thumb {
    width: 56%;
    height: 5px;
    position: absolute;
    left: 1px;
    top: 1px;
    background-color: rgb(188, 188, 188);
    border-radius: 3px;
}

.template-row {
    height: 68px;
    flex-direction: row;
    align-items: center;
}

.template-card {
    width: 104px;
    min-width: 104px;
    height: 66px;
    margin-right: 10px;
    padding: 0;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 2px;
    border-color: transparent;
    border-radius: 17px;
    flex-shrink: 0;
}

.template-card-end {
    margin-right: 0;
}

.template-selected {
    border-width: 3px;
    border-color: white;
    border-left-color: rgb(0, 76, 184);
    border-right-color: rgb(0, 76, 184);
    border-top-color: rgb(0, 76, 184);
    border-bottom-color: rgb(0, 76, 184);
}

.template-blue { background-image: url("project://database/Assets/UI/Images/CreateClass/template-blue.png"); }
.template-dark { background-image: url("project://database/Assets/UI/Images/CreateClass/template-black.png"); }
.template-purple { background-image: url("project://database/Assets/UI/Images/CreateClass/template-purple.png"); }
.template-red { background-image: url("project://database/Assets/UI/Images/CreateClass/template-red.png"); }

.branding-preview-section {
    width: 100%;
}

.preview-heading {
    margin-top: 17px;
}

.brand-preview-card {
    width: 100%;
    height: 104px;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
}

.brand-preview-background {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-and-crop;
}

.brand-preview-overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 35, 100, 0.22);
}

.brand-preview-text {
    position: absolute;
    left: 16px;
    bottom: 13px;
}

.brand-preview-name {
    margin-bottom: 3px;
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
}

.brand-preview-meta-row { flex-direction: row; }

.brand-preview-meta {
    font-size: 12px;
    color: rgb(221, 235, 255);
}

/* STEP 3: OVERVIEW */
.overview-content {
    padding-top: 26px;
}

.course-description-help {
    margin-top: -2px;
    margin-bottom: 13px;
    white-space: normal;
    font-size: 13px;
    color: rgb(88, 105, 139);
}

.description-field-wrapper {
    width: 100%;
    height: 228px;
    position: relative;
    align-self: center;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 18px;
}

.course-description-field {
    width: 100%;
    height: 228px;
    align-self: center;
    background-color: white;
    border-width: 1px;
    border-color: rgb(221, 227, 238);
    border-radius: 17px;
}

.course-description-field .unity-base-field__input,
.course-description-field .unity-text-input {
    width: 100%;
    height: 226px;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 14px;
    padding-bottom: 46px;
    white-space: normal;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 14px;
    color: rgb(31, 53, 91);
    -unity-text-align: upper-left;
}

.course-description-field:hover,
.course-description-field:focus {
    border-color: rgb(221, 227, 238);
}

.voice-input-button {
    position: absolute;

    right: 12px;
    bottom: 12px;

    width: 28px;
    height: 28px;

    padding: 0;

    background-color: transparent;

    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;

    justify-content: center;
    align-items: center;
}

.voice-input-button:hover {
    background-color: rgb(0, 62, 155);
}

.voice-input-icon {
    width: 30px;
    height: 30px;
    background-image: url("project://database/Assets/UI/Images/CreateClass/voice.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.class-summary-card {
    width: 100%;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 15px;
    padding-bottom: 15px;
    background-color: white;
    border-width: 1px;
    border-color: rgb(221, 227, 238);
    border-radius: 17px;
}

.class-summary-title {
    margin-bottom: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(70, 94, 138);
}

.summary-row {
    width: 100%;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.summary-row-last {
    margin-bottom: 0;
}

.summary-icon {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    margin-right: 10px;
    flex-shrink: 0;

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(0, 76, 184);
}

.summary-book-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/book.png");
}

.summary-course-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/course.png");
}

.summary-calendar-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/calendar.png");
}

.summary-text-group {
    flex-grow: 1;
}

.summary-caption {
    margin-bottom: 1px;
    font-size: 11px;
    color: rgb(118, 134, 165);
}

.summary-value {
    font-size: 14px;
    color: rgb(60, 81, 119);
}

.validation-message {
    margin-top: 12px;
    white-space: normal;
    font-size: 12px;
    color: rgb(205, 44, 56);
}

/* BOTTOM */
.bottom-action-container {
    width: 100%;
    height: 88px;
    flex-shrink: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 15px;
    padding-bottom: 14px;
    justify-content: center;
    background-color: white;
    border-top-width: 1px;
    border-top-color: rgb(225, 230, 240);
}

.primary-button {
    width: 100%;
    height: 56px;
    background-color: rgb(0, 91, 211);
    border-width: 0;
    border-radius: 18px;
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
}

.primary-button:hover { background-color: rgb(0, 75, 184); }
.primary-button:active { background-color: rgb(0, 63, 158); }
.hidden { display: none; }
