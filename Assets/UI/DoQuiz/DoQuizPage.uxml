<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements">

    <Style src="project://database/Assets/UI/DoQuiz/DoQuizPage.uss"/>

    <ui:VisualElement name="do-quiz-page" class="do-quiz-page">

        <!-- Header -->
        <ui:VisualElement class="quiz-header">

            <ui:Button
                name="back-button"
                text="‹"
                class="back-button"/>

            <ui:VisualElement class="header-content">

                <ui:Label
                    name="quiz-name-label"
                    text="Lesson 8 Mini-Quiz"
                    class="quiz-name-label"/>

                <ui:Label
                    name="question-number-label"
                    text="Question 1 of 5"
                    class="question-number-label"/>

            </ui:VisualElement>

            <!-- Right menu -->
            <ui:Button
                name="quiz-menu-button"
                text="⋮"
                class="quiz-menu-button"/>

        </ui:VisualElement>

        <!-- Progress -->
        <ui:VisualElement class="progress-section">

            <ui:VisualElement class="progress-track">
                <ui:VisualElement
                    name="progress-fill"
                    class="progress-fill"/>
            </ui:VisualElement>

            <ui:VisualElement
                name="progress-dots-container"
                class="progress-dots-container">

                <ui:VisualElement class="progress-dot progress-dot-active"/>
                <ui:VisualElement class="progress-dot"/>
                <ui:VisualElement class="progress-dot"/>
                <ui:VisualElement class="progress-dot"/>
                <ui:VisualElement class="progress-dot"/>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Main scroll area -->
        <ui:ScrollView
            name="quiz-scroll-view"
            class="quiz-scroll-view"
            mode="Vertical">

            <ui:VisualElement class="quiz-content">

                <ui:Label
                    name="quiz-message-label"
                    text=""
                    class="quiz-message-label hidden"/>

                <!-- Question card -->
                <ui:VisualElement class="question-card">

                    <ui:VisualElement class="question-meta-row">

                        <ui:Label
                            name="question-badge-label"
                            text="Q1"
                            class="question-badge"/>

                        <ui:Label
                            name="question-category-label"
                            text="Electronics · Fundamentals"
                            class="question-category-label"/>

                    </ui:VisualElement>

                    <ui:Label
                        name="question-text-label"
                        text="Which component is primarily responsible for voltage regulation in a power supply circuit?"
                        class="question-text-label"/>

                </ui:VisualElement>

                <!-- Answers -->
                <ui:VisualElement
                    name="answers-container"
                    class="answers-container">

                    <ui:Button
                        name="answer-a-button"
                        class="answer-button">

                        <ui:VisualElement class="answer-content">

                            <ui:Label
                                text="A"
                                class="answer-letter"/>

                            <ui:Label
                                name="answer-a-label"
                                text="Answer A"
                                class="answer-text"/>

                        </ui:VisualElement>

                    </ui:Button>

                    <ui:Button
                        name="answer-b-button"
                        class="answer-button">

                        <ui:VisualElement class="answer-content">

                            <ui:Label
                                text="B"
                                class="answer-letter"/>

                            <ui:Label
                                name="answer-b-label"
                                text="Answer B"
                                class="answer-text"/>

                        </ui:VisualElement>

                    </ui:Button>

                    <ui:Button
                        name="answer-c-button"
                        class="answer-button">

                        <ui:VisualElement class="answer-content">

                            <ui:Label
                                text="C"
                                class="answer-letter"/>

                            <ui:Label
                                name="answer-c-label"
                                text="Answer C"
                                class="answer-text"/>

                        </ui:VisualElement>

                    </ui:Button>

                    <ui:Button
                        name="answer-d-button"
                        class="answer-button">

                        <ui:VisualElement class="answer-content">

                            <ui:Label
                                text="D"
                                class="answer-letter"/>

                            <ui:Label
                                name="answer-d-label"
                                text="Answer D"
                                class="answer-text"/>

                        </ui:VisualElement>

                    </ui:Button>

                </ui:VisualElement>

                <!-- Review navigation: below answer D, review mode only -->
                <ui:VisualElement
                    name="review-navigation"
                    class="review-navigation hidden">

                    <ui:Button
                        name="review-prev-button"
                        text="&lt;"
                        class="review-nav-button review-nav-button-left"/>

                    <ui:Button
                        name="review-next-button"
                        text="&gt;"
                        class="review-nav-button review-nav-button-right"/>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:ScrollView>

        <!-- Bottom action -->
        <ui:VisualElement class="bottom-action-container">

            <ui:Button
                name="next-question-button"
                text="Next Question →"
                class="next-question-button"/>

        </ui:VisualElement>

        <!-- Right question navigator drawer -->
        <ui:VisualElement
            name="quiz-drawer-overlay"
            class="quiz-drawer-overlay hidden">

            <ui:VisualElement
                name="quiz-drawer-scrim"
                class="quiz-drawer-scrim"/>

            <ui:VisualElement
                name="quiz-drawer-panel"
                class="quiz-drawer-panel">

                <ui:VisualElement class="quiz-drawer-header">

                    <ui:Label
                        name="quiz-drawer-title"
                        text="Questions"
                        class="quiz-drawer-title"/>

                    <ui:Button
                        name="quiz-drawer-close-button"
                        text="×"
                        class="quiz-drawer-close-button"/>

                </ui:VisualElement>

                <ui:VisualElement
                    name="quiz-drawer-question-grid"
                    class="quiz-drawer-question-grid"/>

                <ui:Button
                    name="quiz-drawer-action-button"
                    text="Nộp bài"
                    class="quiz-drawer-action-button"/>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Submit confirmation -->
        <ui:VisualElement
            name="submit-confirm-overlay"
            class="submit-confirm-overlay hidden">

            <ui:VisualElement class="submit-confirm-card">

                <ui:Label
                    text="Xác nhận nộp bài"
                    class="submit-confirm-title"/>

                <ui:Label
                    name="submit-confirm-message"
                    text="Bạn có chắc chắn muốn nộp bài?"
                    class="submit-confirm-message"/>

                <ui:VisualElement class="submit-confirm-actions">

                    <ui:Button
                        name="submit-confirm-cancel-button"
                        text="Hủy"
                        class="submit-confirm-cancel-button"/>

                    <ui:Button
                        name="submit-confirm-submit-button"
                        text="Nộp bài"
                        class="submit-confirm-submit-button"/>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement
            name="result-overlay"
            class="result-overlay hidden">

            <ui:VisualElement class="result-card">

                <ui:Label
                    text="Quiz Submitted"
                    class="result-title"/>

                <ui:Label
                    name="result-correct-label"
                    text="Correct: 0 / 0"
                    class="result-correct-label"/>

                <ui:Label
                    name="result-score-label"
                    text="Score: 0 / 10"
                    class="result-score-label"/>

                <ui:Label
                    text="Your answers have been saved."
                    class="result-message"/>

                <ui:Button
                    name="result-back-button"
                    text="Back to Quiz Overview"
                    class="result-back-button"/>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>