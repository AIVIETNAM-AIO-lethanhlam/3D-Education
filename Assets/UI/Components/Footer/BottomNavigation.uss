/* =========================================================
   ICON SOURCES
   ========================================================= */

.icon-nav-home {
    background-image:
        url("project://database/Assets/UI/Images/Icons/home.png");
}

.icon-nav-classes {
    background-image:
        url("project://database/Assets/UI/Images/Icons/category-all.png");
}

.icon-nav-ai {
    background-image:
        url("project://database/Assets/UI/Images/Icons/ai-sparkle.png");
}

.icon-nav-settings {
    background-image:
        url("project://database/Assets/UI/Images/Icons/settings.png");
}

/* =========================================================
   FOOTER ROOT
   ========================================================= */

.bottom-navigation {
    width: 100%;
    height: 86px;
    min-height: 86px;
    max-height: 86px;

    flex-grow: 0;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding-top: 5px;
    padding-right: 0;
    padding-bottom: 5px;
    padding-left: 0;

    margin: 0;

    background-color: rgb(255, 255, 255);

    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;

    border-top-color: rgb(216, 225, 240);
}

/* =========================================================
   NAVIGATION BUTTON
   ========================================================= */

.nav-button {
    width: 25%;
    height: 75px;

    flex-grow: 0;
    flex-shrink: 0;

    margin: 0;
    padding: 0;

    background-color: rgba(255, 255, 255, 0);

    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;

    border-radius: 0;
}

.nav-button-content {
    width: 100%;
    height: 100%;

    flex-grow: 1;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    margin: 0;
    padding: 0;
}

/* =========================================================
   ICON
   ========================================================= */

.nav-icon {
    width: 24px;
    height: 24px;

    flex-grow: 0;
    flex-shrink: 0;

    margin-top: 0;
    margin-right: 0;
    margin-bottom: 6px;
    margin-left: 0;

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(91, 107, 143);
}

/* =========================================================
   LABEL
   ========================================================= */

.nav-label {
    height: 18px;

    margin: 0;
    padding: 0;

    font-size: 12px;
    color: rgb(70, 87, 123);

    -unity-text-align: middle-center;
}

/* =========================================================
   ACTIVE TAB
   ========================================================= */

.nav-button-active {
    background-color: rgba(0, 70, 180, 0);
}

.nav-button-active .nav-icon {
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

.nav-button-active .nav-label {
    color: rgb(0, 70, 180);
    -unity-font-style: bold;
}


/* =========================================================
   INTERACTION
   ========================================================= */

.nav-button:hover {
    background-color: rgba(0, 70, 180, 0.04);
}

.nav-button:active {
    background-color: rgba(0, 70, 180, 0.08);
}

/*
   Giữ màu xanh cho tab active kể cả khi rê chuột hoặc nhấn.
*/

.nav-button-active:hover {
    background-color: rgba(0, 70, 180, 0.04);
}

.nav-button-active:active {
    background-color: rgba(0, 70, 180, 0.08);
}

.nav-button-active:hover .nav-icon,
.nav-button-active:active .nav-icon {
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

.nav-button-active:hover .nav-label,
.nav-button-active:active .nav-label {
    color: rgb(0, 70, 180);
}