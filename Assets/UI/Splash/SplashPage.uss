/* =========================================================
   ROOT
   ========================================================= */

.splash-root {
    width: 100%;
    height: 100%;

    position: relative;

    flex-grow: 1;
    flex-direction: column;

    background-color: rgb(2, 25, 78);

    background-image:
        url("project://database/Assets/UI/Splash/Images/splash-background.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-and-crop;

    overflow: hidden;
}


/* =========================================================
   BRANDING
   ========================================================= */

.branding-container {
    position: absolute;

    top: 27%;
    left: 0;
    right: 0;

    align-items: center;
    justify-content: center;
}


/* =========================================================
   LOGO
   ========================================================= */

.logo-shadow {
    width: 146px;
    height: 146px;

    align-items: center;
    justify-content: center;

    background-color: rgba(62, 114, 203, 0.28);

    border-top-left-radius: 73px;
    border-top-right-radius: 73px;
    border-bottom-left-radius: 73px;
    border-bottom-right-radius: 73px;

    margin-bottom: 13px;
}

.logo-circle {
    width: 124px;
    height: 124px;

    align-items: center;
    justify-content: center;

    background-color: rgb(248, 249, 253);

    border-top-left-radius: 62px;
    border-top-right-radius: 62px;
    border-bottom-left-radius: 62px;
    border-bottom-right-radius: 62px;
}

.app-logo {
    width: 120px;
    height: 120px;

    background-image:
        url("project://database/Assets/UI/Splash/Images/splash-logo.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
}


/* =========================================================
   TEXT
   ========================================================= */

.app-title {
    margin-top: 2px;

    color: rgb(255, 255, 255);

    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.university-name {
    margin-top: 2px;

    color: rgb(107, 157, 225);

    font-size: 9px;
    letter-spacing: 2px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}


/* =========================================================
   LOADING AREA
   ========================================================= */

.loading-container {
    position: absolute;

    left: 10%;
    right: 10%;
    bottom: 4.5%;

    align-items: center;
}

.loading-label {
    margin-bottom: 17px;

    color: rgba(129, 165, 221, 0.95);

    font-size: 11px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}


/* =========================================================
   PROGRESS BAR
   ========================================================= */

.progress-track {
    width: 100%;
    height: 4px;

    background-color: rgba(75, 108, 167, 0.48);

    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;

    overflow: hidden;
}

.progress-fill {
    width: 0px;
    height: 100%;

    flex-shrink: 0;

    background-color: rgb(44, 200, 255);

    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}


/* =========================================================
   LOADING DOTS
   ========================================================= */

.loading-dots {
    margin-top: 17px;

    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.loading-dot {
    width: 5px;
    height: 5px;

    margin-left: 4px;
    margin-right: 4px;

    background-color: rgba(86, 122, 184, 0.45);

    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.loading-dot-active {
    width: 6px;
    height: 6px;

    background-color: rgb(37, 149, 232);
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-height: 700px) {
    .branding-container {
        top: 21%;
    }

    .logo-shadow {
        width: 126px;
        height: 126px;

        border-top-left-radius: 63px;
        border-top-right-radius: 63px;
        border-bottom-left-radius: 63px;
        border-bottom-right-radius: 63px;
    }

    .logo-circle {
        width: 106px;
        height: 106px;

        border-top-left-radius: 53px;
        border-top-right-radius: 53px;
        border-bottom-left-radius: 53px;
        border-bottom-right-radius: 53px;
    }

    .app-logo {
        width: 120px;
        height: 120px;
    }

    .app-title {
        font-size: 23px;
    }
}