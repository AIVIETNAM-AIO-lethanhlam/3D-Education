# =========================================================
# Unity generated folders (project root only)
# =========================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Addressables / StreamingAssets build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Uncomment if Asset Store Tools are ever imported
# /[Aa]ssets/AssetStoreTools*

# =========================================================
# Builds (APK / AAB / exported projects)
# =========================================================
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Unity debug symbols
*.pidb
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# =========================================================
# IDE / editor files
# =========================================================
.vs/
.vscode/
.idea/
.consulo/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
*.opendb
*.VC.db
ExportedObj/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================================================
# Unity Version Control / Plastic SCM
# =========================================================
.plastic/
.utmp/
ignore.conf

# =========================================================
# Node
# =========================================================
node_modules/

# =========================================================
# Environment variables / secrets
# =========================================================
**/.env
**/.env.*
!**/.env.example
!**/.env.template
Backend/model_analysis_worker/cloudrun-env.yaml

# =========================================================
# Python
# =========================================================
**/__pycache__/
*.py[cod]
*$py.class
**/.venv/
**/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================================================
# Local-only editor helper (serves /Screenshots on localhost for the report)
# =========================================================
/[Aa]ssets/Scripts/Dev/
/[Aa]ssets/Scripts/Dev.meta

# =========================================================
# Local backups / screenshots (not part of the project)
# =========================================================
_claude_backup_*/
_backup_*/
/Screenshots/

# Old Mode3D screenshots saved at the project root (now saved to /Screenshots/)
/Mode3D_*.png
/VirtualEducation_*.png

# Unity-generated UI Toolkit schema (recreated by the Editor)
/UIElementsSchema/

# =========================================================
# Supabase CLI local state (keep functions/ and migrations/)
# =========================================================
supabase/.temp/
supabase/.branches/

# =========================================================
# Temporary files created by Unity during an Android build
# (removed again when the build finishes; never commit them)
# =========================================================
# AR Foundation XR Simulation moves its settings here while building
/[Aa]ssets/XR/Temp/
/[Aa]ssets/XR/Temp.meta
# unity-webview copies its plugin here only for the build
/[Aa]ssets/Plugins/Android/WebViewPlugin.aar
/[Aa]ssets/Plugins/Android/WebViewPlugin.aar.meta
# Unity Performance Testing package run info
/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
