/* =========================================================
   MY CLASSES PAGE
   Target: narrow Android phone / Foldable Device viewport
   ========================================================= */

.my-classes-page {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(247, 249, 253);
}

.my-classes-scroll-view {
    flex-grow: 1;
    background-color: rgb(247, 249, 253);
}

/*
 * Remove the space normally reserved for the vertical scrollbar.
 * Scrolling still works with mouse wheel, touch and drag.
 */
.my-classes-scroll-view > .unity-scroll-view__vertical-scroller,
.my-classes-scroll-view > .unity-scroll-view__horizontal-scroller,
.my-classes-scroll-view .unity-scroller {
    display: none;
    width: 0;
    height: 0;
}

.my-classes-scroll-view > .unity-scroll-view__content-viewport {
    width: 100%;
    flex-grow: 1;
    padding: 0;
}

.my-classes-scroll-view > .unity-scroll-view__content-viewport >
.unity-scroll-view__content-container {
    width: 100%;

    padding-top: 18px;
    padding-right: 0;
    padding-left: 0;

    align-items: stretch;
}

.role-content {
    display: none;

    align-self: stretch;

    margin-right: 20px;
    margin-left: 20px;
}

.page-bottom-space {
    height: 28px;
}

/* =========================================================
   SHARED CLASS CARD
   ========================================================= */

.teacher-card,
.student-card {
    position: relative;
    width: 100%;
    margin-bottom: 16px;

    padding-top: 25px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;

    background-color: rgb(255, 255, 255);

    border-width: 1px;
    border-color: rgb(216, 225, 240);
    border-radius: 20px;

    overflow: hidden;
}

.teacher-card-top-line,
.student-card-top-line {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 6px;
}

.card-line-blue {
    background-color: rgb(52, 105, 198);
}

.card-line-purple {
    background-color: rgb(151, 104, 246);
}

.card-line-green {
    background-color: rgb(50, 205, 111);
}

.teacher-card-header,
.student-card-header {
    width: 100%;
    min-height: 72px;

    flex-direction: row;
    align-items: center;
}

.course-icon-shell {
    width: 58px;
    height: 58px;
    flex-grow: 0;
    flex-shrink: 0;

    margin-right: 14px;

    align-items: center;
    justify-content: center;

    border-width: 1.5px;
    border-radius: 29px;
}

.course-icon-blue {
    background-color: rgb(239, 245, 255);
    border-color: rgb(195, 213, 242);
}

.course-icon-purple {
    background-color: rgb(248, 241, 255);
    border-color: rgb(227, 210, 255);
}

.course-icon-green {
    background-color: rgb(237, 253, 244);
    border-color: rgb(196, 238, 210);
}

.course-icon {
    width: 30px;
    height: 30px;

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-course-circuit {
    background-image:
        url("project://database/Assets/UI/Images/Icons/category-all.png");
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

.icon-course-physics {
    background-image:
        url("project://database/Assets/UI/Images/Icons/physics.png");
    -unity-background-image-tint-color: rgb(137, 83, 245);
}

.icon-course-ai {
    background-image:
        url("project://database/Assets/UI/Images/Icons/ai-sparkle.png");
    -unity-background-image-tint-color: rgb(25, 196, 92);
}

.teacher-course-info,
.student-course-info {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.teacher-course-info {
    justify-content: center;
}

.course-meta-row,
.course-title-row {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.course-code {
    margin-right: 6px;

    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 3px;
    padding-left: 8px;

    border-radius: 11px;

    font-size: 10px;
    -unity-font-style: bold;
}

.course-code-blue {
    color: rgb(0, 70, 180);
    background-color: rgb(235, 242, 255);
}

.course-code-purple {
    color: rgb(134, 76, 239);
    background-color: rgb(246, 238, 255);
}

.course-code-green {
    color: rgb(24, 190, 83);
    background-color: rgb(235, 252, 241);
}

.status-dot {
    width: 6px;
    height: 6px;

    flex-grow: 0;
    flex-shrink: 0;

    margin-right: 4px;
    border-radius: 3px;
}

.status-dot-public {
    background-color: rgb(0, 190, 73);
}

.status-dot-private {
    background-color: rgb(222, 54, 54);
}

.status-label {
    font-size: 10px;
    white-space: nowrap;
}

.status-public {
    color: rgb(0, 174, 67);
}

.status-private {
    color: rgb(205, 42, 42);
}

.course-title-row {
    margin-top: 6px;
}

.teacher-header-actions {
    flex-grow: 0;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    margin-left: 10px;
}

.teacher-header-actions .round-edit-button {
    width: 38px;
    height: 38px;

    flex-grow: 0;
    flex-shrink: 0;

    margin-left: 0;
    padding: 0;

    align-items: center;
    justify-content: center;

    background-color: rgb(239, 244, 253);

    border-width: 0;
    border-radius: 19px;
}


.course-title {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;

    font-size: 17px;
    color: rgb(9, 28, 67);

    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.round-edit-button {
    width: 30px;
    height: 30px;

    flex-grow: 0;
    flex-shrink: 0;

    margin-left: 6px;
    padding: 0;

    align-items: center;
    justify-content: center;

    background-color: rgb(239, 244, 253);

    border-width: 0;
    border-radius: 15px;
}

.delete-button {
    height: 38px;
    min-width: 78px;

    flex-grow: 0;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    margin-left: 0;

    padding-right: 11px;
    padding-left: 11px;

    background-color: rgb(255, 244, 244);

    border-width: 1px;
    border-color: rgb(255, 178, 178);
    border-radius: 19px;
}

.delete-icon {
    margin-right: 4px;
    font-size: 12px;
    color: rgb(244, 61, 61);
}

.delete-label {
    font-size: 11px;
    color: rgb(244, 61, 61);
    -unity-font-style: bold;
}

.card-divider {
    height: 1px;
    margin-top: 18px;
    margin-bottom: 18px;
    background-color: rgb(218, 226, 240);
}

/* =========================================================
   TEACHER VIEW
   ========================================================= */

.teacher-stats-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 18px;
}

.stat-box {
    width: 31.5%;
    min-height: 92px;

    align-items: center;
    justify-content: center;

    padding-top: 8px;
    padding-bottom: 8px;

    background-color: rgb(239, 244, 253);
    border-radius: 22px;
}

.stat-icon {
    margin-bottom: 2px;
    font-size: 14px;
    color: rgb(82, 102, 143);
}

.stat-value {
    font-size: 22px;
    color: rgb(0, 70, 180);
    -unity-font-style: bold;
}

.stat-caption {
    margin-top: 1px;

    font-size: 11px;
    color: rgb(83, 100, 137);

    -unity-text-align: middle-center;
    white-space: normal;
}

.manage-button {
    width: 100%;
    height: 52px;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    border-width: 0;
    border-radius: 26px;
}

.manage-button-blue {
    background-color: rgb(5, 80, 190);
}

.manage-button-purple {
    background-color: rgb(146, 92, 245);
}

.manage-button-green {
    background-color: rgb(35, 199, 100);
}

.manage-icon {
    margin-right: 7px;
    font-size: 16px;
    color: rgb(255, 255, 255);
}

.manage-label {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* =========================================================
   STUDENT VIEW
   ========================================================= */

.teacher-name {
    margin-top: 3px;

    font-size: 10px;
    color: rgb(88, 104, 140);

    white-space: nowrap;
    overflow: hidden;
}

.progress-header-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;

    margin-top: 18px;
}

.progress-title,
.progress-value {
    font-size: 11px;
}

.progress-title {
    color: rgb(74, 92, 130);
}

.progress-blue {
    color: rgb(0, 70, 180);
}

.progress-purple {
    color: rgb(135, 75, 239);
}

.progress-track {
    width: 100%;
    height: 7px;

    margin-top: 7px;

    background-color: rgb(237, 242, 252);
    border-radius: 4px;
    overflow: hidden;
}

.progress-fill {
    height: 7px;
    border-radius: 4px;
}

.progress-fill-blue {
    background-color: rgb(55, 105, 198);
}

.progress-fill-purple {
    background-color: rgb(153, 101, 243);
}

.progress-72 {
    width: 72%;
}

.progress-45 {
    width: 45%;
}

.student-card-actions {
    width: 100%;
    flex-direction: row;
    align-items: center;
}

.continue-button {
    min-width: 0;
    height: 40px;

    flex-grow: 1;
    flex-shrink: 1;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    margin-right: 8px;

    padding-right: 8px;
    padding-left: 8px;

    border-width: 0;
    border-radius: 20px;
}

.continue-blue {
    background-color: rgb(5, 80, 190);
}

.continue-purple {
    background-color: rgb(151, 96, 245);
}

.continue-icon {
    margin-right: 5px;
    font-size: 12px;
    color: rgb(255, 255, 255);
}

.continue-label {
    font-size: 11px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    white-space: nowrap;
}

.unenroll-button {
    width: 88px;
    height: 40px;

    flex-grow: 0;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    padding-right: 7px;
    padding-left: 7px;

    background-color: rgb(255, 249, 249);

    border-width: 1px;
    border-color: rgb(255, 173, 173);
    border-radius: 20px;
}

.unenroll-icon {
    margin-right: 5px;
    font-size: 15px;
    color: rgb(245, 55, 55);
}

.unenroll-label {
    font-size: 11px;
    color: rgb(245, 55, 55);
    -unity-font-style: bold;
    white-space: nowrap;
}

/* =========================================================
   ACTIVE QUIZZES
   ========================================================= */

.section-title {
    margin-top: 5px;
    margin-bottom: 11px;

    font-size: 16px;
    color: rgb(9, 28, 67);

    -unity-font-style: bold;
}

.quiz-card {
    width: 100%;
    min-height: 70px;

    flex-direction: row;
    align-items: center;

    margin-bottom: 11px;

    padding-top: 11px;
    padding-right: 13px;
    padding-bottom: 11px;
    padding-left: 13px;

    background-color: rgb(255, 255, 255);

    border-width: 1px;
    border-color: rgb(216, 225, 240);
    border-radius: 15px;
}

.quiz-icon-shell {
    width: 39px;
    height: 39px;

    flex-grow: 0;
    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    margin-right: 10px;
    border-radius: 20px;
}

.quiz-icon-blue {
    background-color: rgb(235, 242, 255);
}

.quiz-icon-green {
    background-color: rgb(233, 253, 241);
}

.quiz-icon-orange {
    background-color: rgb(255, 242, 220);
}

.quiz-icon {
    font-size: 18px;
    color: rgb(0, 70, 180);
}

.quiz-icon-green .quiz-icon {
    color: rgb(0, 194, 79);
}

.quiz-icon-orange .quiz-icon {
    color: rgb(255, 157, 0);
}

.quiz-info {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.quiz-title {
    font-size: 14px;
    color: rgb(9, 28, 67);
    -unity-font-style: bold;

    white-space: nowrap;
    overflow: hidden;
}

.quiz-subtitle {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(82, 100, 137);
}

.quiz-open-badge {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 3px;
    padding-left: 8px;

    background-color: rgb(0, 70, 180);
    border-radius: 11px;

    font-size: 9px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.quiz-score {
    font-size: 13px;
    -unity-font-style: bold;
}

.quiz-score-green {
    color: rgb(0, 194, 79);
}

.quiz-score-orange {
    color: rgb(255, 145, 0);
}

/* =========================================================
   INTERACTION
   ========================================================= */

.manage-button:hover,
.continue-button:hover {
    opacity: 0.9;
}

.manage-button:active,
.continue-button:active {
    opacity: 0.75;
}

.delete-button:hover,
.unenroll-button:hover,
.round-edit-button:hover {
    opacity: 0.86;
}

.delete-button:active,
.unenroll-button:active,
.round-edit-button:active {
    opacity: 0.68;
}
/* =========================================================
   FINAL ALIGNMENT
   ========================================================= */

.teacher-card,
.student-card,
.quiz-card {
    width: 100%;
    max-width: 100%;
    align-self: stretch;
}

.section-title,
.student-content > .section-title,
.teacher-content > .section-title {
    width: 100%;
    align-self: flex-start;
    -unity-text-align: middle-left;
}


/* =========================================================
   FINAL RESPONSIVE WIDTH OVERRIDE
   Card area = viewport width - 20px left - 20px right
   ========================================================= */

.my-classes-scroll-view > .unity-scroll-view__content-viewport >
.unity-scroll-view__content-container {
    padding-right: 0;
    padding-left: 0;
}

.role-content {
    width: auto;
    max-width: none;

    margin-top: 15px;
    margin-right: 20px;
    margin-left: 20px;

    align-self: stretch;
}

.teacher-card,
.student-card,
.quiz-card {
    width: 100%;
    max-width: 100%;

    margin-right: 0;
    margin-left: 0;

    align-self: stretch;
}

/* =========================================================
   HEADER / BODY SEPARATION
   Giữ header là một khối trắng riêng, không bị hòa vào body xám.
   ========================================================= */

.my-classes-header {
    flex-grow: 0;
    flex-shrink: 0;

    margin-bottom: 15px;

    background-color: rgb(255, 255, 255);

    border-bottom-width: 1px;
    border-bottom-color: rgb(218, 226, 240);
}

/*
 * Body bắt đầu ở dưới header và giữ nền xám riêng.
 * padding-top tạo khoảng cách giữa đường phân cách và card đầu tiên.
 */
.my-classes-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;

    margin-top: 0;

    background-color: rgb(247, 249, 253);
}

.my-classes-scroll-view > .unity-scroll-view__content-viewport >
.unity-scroll-view__content-container {
    padding-top: 18px;
}

/* =========================================================
   COMPACT TEACHER CARD ACTIONS
   Thu nhỏ icon lớp học, nút Edit và Delete.
   ========================================================= */

.course-icon-shell {
    width: 50px;
    height: 50px;

    margin-right: 12px;

    border-radius: 25px;
}

.course-icon {
    width: 25px;
    height: 25px;
}

.teacher-card-header {
    min-height: 60px;
}

.teacher-header-actions {
    margin-left: 7px;
}

.teacher-header-actions .round-edit-button,
.round-edit-button {
    width: 30px;
    height: 30px;

    margin-left: 0;
    margin-right: 7px;

    padding: 0;

    border-radius: 15px;
}

.round-edit-symbol {
    width: 14px;
    height: 14px;

    flex-grow: 0;
    flex-shrink: 0;

    font-size: 0;

    background-image:
        url("project://database/Assets/UI/Images/Icons/edit.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(74, 96, 139);
}

/* =========================================================
   TIGHTER COURSE HEADER
   Thu nhỏ icon bên trái và giảm khoảng cách giữa metadata
   (mã lớp / trạng thái) với tên lớp học.
   ========================================================= */

.course-icon-shell {
    width: 42px;
    height: 42px;

    margin-right: 10px;

    border-radius: 21px;
}

.course-icon {
    width: 21px;
    height: 21px;
}

.teacher-card-header,
.student-card-header {
    min-height: 50px;
}

.teacher-course-info,
.student-course-info {
    justify-content: center;
}

.course-meta-row {
    margin-top: 0;
    margin-bottom: 0;
}

.course-title-row {
    margin-top: 2px;
    margin-bottom: 0;
}

.course-code {
    padding-top: 2px;
    padding-right: 7px;
    padding-bottom: 2px;
    padding-left: 7px;
}

.course-title {
    line-height: 10px;
}

/* =========================================================
   FINAL COMPACT CARD SPACING
   - Giảm chiều cao stat box
   - Giảm khoảng cách giữa mã lớp và tên lớp
   - Thu nhỏ nút Delete
   ========================================================= */

/* Mã lớp / trạng thái và tên lớp nằm gần nhau hơn */
.course-meta-row {
    margin-top: 0;
    margin-bottom: 0;
}

.course-title-row {
    margin-top: 2px;
    margin-bottom: 0;
}

.course-title {
    line-height: 18px;
}

/* Giảm khoảng cách trước hàng thống kê */
.teacher-stats-row {
    margin-top: 12px;
}

/* Thu gọn ba ô Students / Active Modules / Avg Score */
.stat-box {
    min-height: 76px;

    padding-top: 5px;
    padding-bottom: 5px;

    border-radius: 19px;
}

.stat-icon {
    margin-top: 0;
    margin-bottom: 0;

    font-size: 12px;
    line-height: 13px;
}

.stat-value {
    margin-top: 1px;
    margin-bottom: 0;

    font-size: 20px;
    line-height: 22px;
}

.stat-caption {
    margin-top: 0;
    margin-bottom: 0;

    font-size: 10px;
    line-height: 13px;
}

/* Đường phân cách gần hàng thống kê hơn */
.card-divider {
    margin-top: 13px;
    margin-bottom: 13px;
}

/* Nút Delete nhỏ và gọn hơn */
.delete-button {
    min-width: 50px;
    height: 30px;

    padding-right: 8px;
    padding-left: 8px;

    border-radius: 15px;
}

.delete-icon {
    width: 12px;
    height: 12px;

    flex-grow: 0;
    flex-shrink: 0;

    margin-right: 2px;
    margin-left: 1px;

    font-size: 0;

    background-image:
        url("project://database/Assets/UI/Images/Icons/delete.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(244, 61, 61);
}

.delete-label {
    font-size: 10px;
}

/* =========================================================
   STAT ICONS
   ========================================================= */

.stat-image-icon {
    width: 14px;
    min-width: 14px;
    max-width: 14px;

    height: 14px;
    min-height: 14px;
    max-height: 14px;

    flex-grow: 0;
    flex-shrink: 0;

    margin-top: 0;
    margin-bottom: 2px;

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(82, 102, 143);
}

.icon-stat-students {
    background-image:
        url("project://database/Assets/UI/Images/Icons/students.png");
}

.icon-stat-modules {
    background-image:
        url("project://database/Assets/UI/Images/Icons/book.png");
}

.icon-stat-score {
    background-image:
        url("project://database/Assets/UI/Images/Icons/trend-up.png");
}


/* =========================================================
   DYNAMIC SUPABASE CLASS CARDS
   These classes are used by MyClassesPageController.cs.
   ========================================================= */

/* Full card border tint, matching the top accent and Manage button. */
.teacher-card-blue {
    border-color: rgb(190, 211, 244);
}

.teacher-card-pink {
    border-color: rgb(229, 207, 255);
}

.teacher-card-green {
    border-color: rgb(193, 235, 207);
}

.teacher-card-sand {
    border-color: rgb(232, 218, 180);
}

/* Top accent line. */
.card-line-pink {
    background-color: rgb(157, 104, 246);
}

.card-line-sand {
    background-color: rgb(198, 158, 73);
}

/* Course icon shells. */
.course-icon-pink {
    background-color: rgb(248, 241, 255);
    border-color: rgb(226, 208, 255);
}

.course-icon-sand {
    background-color: rgb(252, 247, 232);
    border-color: rgb(232, 216, 174);
}

/* Generic course icon used by dynamically loaded Supabase classes. */
.icon-course-dynamic {
    background-image:
        url("project://database/Assets/UI/Images/Icons/category-all.png");

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-course-dynamic-blue {
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

.icon-course-dynamic-pink {
    -unity-background-image-tint-color: rgb(139, 82, 238);
}

.icon-course-dynamic-green {
    -unity-background-image-tint-color: rgb(23, 186, 81);
}

.icon-course-dynamic-sand {
    -unity-background-image-tint-color: rgb(165, 125, 45);
}

/* Course-code badge colors. */
.course-code-pink {
    color: rgb(136, 75, 237);
    background-color: rgb(246, 238, 255);
}

.course-code-sand {
    color: rgb(151, 111, 35);
    background-color: rgb(250, 244, 225);
}

/* Manage button colors. */
.manage-button-pink {
    background-color: rgb(146, 92, 245);
}

.manage-button-sand {
    background-color: rgb(189, 147, 62);
}

/* Use actual image assets instead of empty VisualElements/text glyphs. */
.delete-icon {
    width: 14px;
    min-width: 14px;
    height: 14px;
    min-height: 14px;

    margin-right: 5px;

    background-image:
        url("project://database/Assets/UI/Images/Icons/delete.png");

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(244, 61, 61);
}

.manage-image-icon {
    width: 14px;
    min-width: 14px;
    height: 14px;
    min-height: 14px;

    background-image:
        url("project://database/Assets/UI/Images/Icons/trend-up.png");

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Keep action buttons aligned like the Figma card. */
.teacher-header-actions {
    margin-left: 8px;
}

.teacher-header-actions .round-edit-button {
    width: 32px;
    height: 32px;
    border-radius: 16px;
}

.delete-button {
    height: 32px;
    min-width: 72px;
    border-radius: 16px;
}

/* Dynamic cards use a compact Figma-like layout. */
.teacher-card {
    padding-top: 20px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
}

.teacher-stats-row {
    margin-top: 14px;
}

.stat-box {
    min-height: 74px;
    border-radius: 16px;
}

.stat-value {
    font-size: 18px;
}

.stat-caption {
    font-size: 9px;
}

.card-divider {
    margin-top: 14px;
    margin-bottom: 14px;
}

.manage-button {
    height: 42px;
    border-radius: 21px;
}


/* =========================================================
   STUDENT ROLE – FIGMA ALIGNMENT FIX
   These overrides only affect student cards.
   Teacher cards remain unchanged.
   ========================================================= */

/* Align the course icon with the code/title block instead of centering it
   against the full header height. */
.student-card-header {
    min-height: 58px;
    align-items: flex-start;
}

.student-card-header > .course-icon-shell {
    margin-top: 2px;
}

/* Keep the text block compact and aligned with the icon. */
.student-course-info {
    justify-content: flex-start;
}

.student-course-info > .course-meta-row {
    margin-top: 0;
    margin-bottom: 1px;
}

.student-course-info > .course-title {
    margin-top: 0;
    margin-bottom: 0;
    line-height: 18px;
}

/* Teacher name row with the real profile.png asset. */
.student-teacher-row {
    min-width: 0;
    flex-direction: row;
    align-items: center;

    margin-top: 3px;
}

.student-teacher-icon {
    width: 11px;
    min-width: 11px;
    height: 11px;
    min-height: 11px;

    margin-right: 5px;

    background-image:
        url("project://database/Assets/UI/Images/Icons/profile.png");

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(88, 104, 140);
}

.student-teacher-row > .teacher-name {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;

    margin-top: 0;

    font-size: 10px;
    color: rgb(88, 104, 140);

    white-space: nowrap;
    overflow: hidden;
}

/* Reduce the large empty gap above Progress without changing teacher cards. */
.student-card > .progress-header-row {
    margin-top: 10px;
}

.student-card > .progress-track {
    margin-top: 6px;
}

/* Slightly compact the student card to match the Figma proportions. */
.student-card {
    padding-top: 20px;
}

.student-card > .card-divider {
    margin-top: 13px;
    margin-bottom: 13px;
}


/* =========================================================
   STUDENT ROLE – COURSE ICON + CONTINUE BUTTON ICON
   Only affects student cards. Teacher cards remain unchanged.
   ========================================================= */

/* Match the Figma proportions:
   smaller shell, moved slightly down, aligned with meta + title block. */
.student-card-header {
    min-height: 62px;
    align-items: flex-start;
}

.student-card-header > .course-icon-shell {
    width: 48px;
    min-width: 48px;
    height: 48px;
    min-height: 48px;

    margin-top: 7px;
    margin-right: 12px;

    border-radius: 24px;
}

.student-card-header > .course-icon-shell > .course-icon {
    width: 25px;
    min-width: 25px;
    height: 25px;
    min-height: 25px;
}

/* Keep course information aligned with the top of the icon. */
.student-course-info {
    padding-top: 1px;
}

.student-course-info > .course-meta-row {
    margin-top: 0;
}

.student-course-info > .course-title {
    margin-top: 1px;
}

/* Use book.png instead of a text glyph in Continue Learning. */
.continue-icon {
    width: 14px;
    min-width: 14px;
    height: 14px;
    min-height: 14px;

    margin-right: 6px;

    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.continue-book-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/book-white.png");
}

/* =========================================================
   SUPABASE-DYNAMIC STUDENT CONTENT
   ========================================================= */
.student-classes-container,
.student-quizzes-container,
.student-quizzes-section {
    width: 100%;
}

.student-quizzes-section {
    margin-top: 18px;
}

.student-quizzes-section.is-hidden {
    display: none;
}

.classes-state-card {
    width: 100%;
    min-height: 150px;
    margin-top: 18px;
    padding: 24px 20px;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(218, 228, 244);
    border-radius: 18px;
}

.classes-state-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
    background-image: url("project://database/Assets/UI/Images/Icons/book.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(24, 84, 195);
}

.classes-state-title {
    margin-bottom: 5px;
    color: rgb(20, 42, 79);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.classes-state-description {
    max-width: 250px;
    color: rgb(112, 128, 153);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.classes-state-message {
    width: 100%;
    padding: 24px 12px;
    color: rgb(112, 128, 153);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}


/* =========================================================
   STUDENT EMPTY STATE
   ========================================================= */

.student-state-container {
    width: 100%;
    flex-grow: 1;
    align-items: center;
}

#student-empty-state {
    width: 88%;
    max-width: 360px;
    min-height: 220px;

    margin-top: 72px;
    margin-left: auto;
    margin-right: auto;

    padding-top: 34px;
    padding-right: 24px;
    padding-bottom: 34px;
    padding-left: 24px;
}

#student-empty-state .classes-state-icon {
    width: 72px;
    height: 72px;
    margin-bottom: 18px;
}

#student-empty-state .classes-state-title {
    margin-bottom: 8px;
    font-size: 18px;
}

#student-empty-state .classes-state-description {
    max-width: 280px;
    font-size: 12px;
    line-height: 18px;
}

.student-state-container.is-hidden,
.student-classes-container.is-hidden,
.student-quizzes-section.is-hidden {
    display: none;
}


/* =========================================================
   ACTIVE QUIZZES - STUDENT
   ========================================================= */

.student-quizzes-section {
    width: 100%;
    margin-top: 22px;
}

.student-quizzes-container:empty {
    min-height: 0;
    margin-top: 0;
    padding: 0;
}

/* Khi chưa có quiz, chỉ giữ lại tiêu đề Active Quizzes. */
.student-quizzes-section > .section-title {
    margin-bottom: 12px;
}
