/* --- ROOT --- */
.root-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    picking-mode: Ignore;
}

/* --- TOP BAR --- */
.top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 110px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 40px;
    padding-left: 20px;
    padding-right: 20px;
    picking-mode: Ignore;
}

.btn-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: Ignore;
}

.back-btn {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    background-color: #162e51;
    border-width: 0;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.back-btn:hover { background-color: #214373; }
.back-btn:active { background-color: #0d1e36; }

.icon-back {
    background-image: url('Icons/back-white.png');
}

.menu-btn {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background-color: #162e51;
    border-width: 0;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.menu-btn:hover { background-color: #214373; }
.menu-btn:active { background-color: #0d1e36; }

.icon-menu {
    background-image: url('Icons/menu-white.png');
}

/* --- DROP DOWN MENU --- */
.menu-panel {
    position: absolute;
    top: 106px;
    right: 20px;
    width: 58px;
    background-color: #162e51;
    border-radius: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    align-items: center;
    picking-mode: Position;
}

.sub-menu-btn {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background-color: transparent;
    border-width: 0;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 0;
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.sub-menu-btn:hover { background-color: rgba(255, 255, 255, 0.15); }
.sub-menu-btn:active { background-color: rgba(0, 0, 0, 0.2); }

/* --- LOADING / ERROR STATUS --- */
.loading-panel {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 105px;
    min-width: 190px;
    background-color: rgba(22, 46, 81, 0.94);
    border-radius: 14px;
    padding: 12px 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    picking-mode: Ignore;
}

.loading-label {
    color: #ffffff;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* --- MODEL POPUP --- */
.popup-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.65);
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.popup-card {
    width: 82%;
    max-width: 360px;
    max-height: 520px;
    background-color: #162e51;
    border-radius: 18px;
    padding: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.popup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    padding-bottom: 12px;
}

.popup-title {
    color: #ffffff;
    font-size: 17px;
    -unity-font-style: bold;
}

.popup-close-btn {
    width: 32px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    border-width: 0;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
}

.popup-close-btn:hover {
    background-color: rgba(255, 85, 85, 0.8);
}

.popup-close-text {
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    picking-mode: Ignore;
}

.model-scroll-view {
    max-height: 340px;
}

.model-item-btn {
    min-height: 58px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    border-width: 1px;
    border-color: transparent;
    margin-bottom: 10px;
    padding: 10px 14px;
    justify-content: center;
    align-items: stretch;
}

.model-item-btn:hover {
    background-color: rgba(255, 255, 255, 0.20);
}

.model-item-btn-selected {
    background-color: #2161b5;
    border-color: #4b8df8;
}

.model-item-text-area {
    flex-grow: 1;
}

.model-item-name {
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.model-item-state {
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    margin-top: 3px;
}

.model-empty-label {
    color: rgba(255, 255, 255, 0.78);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding-top: 16px;
    padding-bottom: 16px;
}

.hidden {
    display: none;
}
