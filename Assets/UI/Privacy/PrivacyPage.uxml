<?xml version="1.0" encoding="utf-8"?>

<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <ui:Template
        name="GeneralHeader"
        src="project://database/Assets/UI/Components/Header/GeneralHeader.uxml"/>

    <Style
        src="project://database/Assets/UI/Privacy/PrivacyPage.uss"/>

    <ui:VisualElement
        name="privacy-page-root"
        class="privacy-page-root">

        <!-- SHARED HEADER -->
        <ui:Instance template="GeneralHeader"/>

        <!-- SCROLLABLE CONTENT -->
        <ui:ScrollView
            name="privacy-scroll"
            class="privacy-scroll"
            mode="Vertical"
            horizontal-scroller-visibility="Hidden"
            vertical-scroller-visibility="Hidden">

            <ui:VisualElement class="privacy-content">

                <!-- INTRODUCTION (text is set by PrivacyPageController for EN / VI) -->
                <ui:VisualElement class="privacy-intro-card">
                    <ui:Label
                        name="privacy-intro-label"
                        text=""
                        class="privacy-intro-text"/>
                </ui:VisualElement>

                <!-- SECTION 1 -->
                <ui:VisualElement
                    name="privacy-section-1"
                    class="privacy-section privacy-section-expanded">

                    <ui:Button
                        name="privacy-section-1-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-1-title"
                            text="1. Data Collection"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-1-arrow"
                            class="privacy-section-arrow privacy-section-arrow--expanded"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-1-content"
                        class="privacy-section-content">

                        <ui:Label
                            name="privacy-section-1-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECTION 2 -->
                <ui:VisualElement
                    name="privacy-section-2"
                    class="privacy-section">

                    <ui:Button
                        name="privacy-section-2-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-2-title"
                            text="2. How We Use Your Data"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-2-arrow"
                            class="privacy-section-arrow"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-2-content"
                        class="privacy-section-content privacy-section-content-hidden">

                        <ui:Label
                            name="privacy-section-2-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECTION 3 -->
                <ui:VisualElement
                    name="privacy-section-3"
                    class="privacy-section">

                    <ui:Button
                        name="privacy-section-3-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-3-title"
                            text="3. Data Sharing &amp; Third Parties"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-3-arrow"
                            class="privacy-section-arrow"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-3-content"
                        class="privacy-section-content privacy-section-content-hidden">

                        <ui:Label
                            name="privacy-section-3-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECTION 4 -->
                <ui:VisualElement
                    name="privacy-section-4"
                    class="privacy-section">

                    <ui:Button
                        name="privacy-section-4-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-4-title"
                            text="4. Security &amp; Encryption"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-4-arrow"
                            class="privacy-section-arrow"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-4-content"
                        class="privacy-section-content privacy-section-content-hidden">

                        <ui:Label
                            name="privacy-section-4-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECTION 5 -->
                <ui:VisualElement
                    name="privacy-section-5"
                    class="privacy-section">

                    <ui:Button
                        name="privacy-section-5-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-5-title"
                            text="5. Your Rights"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-5-arrow"
                            class="privacy-section-arrow"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-5-content"
                        class="privacy-section-content privacy-section-content-hidden">

                        <ui:Label
                            name="privacy-section-5-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECTION 6 -->
                <ui:VisualElement
                    name="privacy-section-6"
                    class="privacy-section">

                    <ui:Button
                        name="privacy-section-6-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-6-title"
                            text="6. Terms of Academic Use"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-6-arrow"
                            class="privacy-section-arrow"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-6-content"
                        class="privacy-section-content privacy-section-content-hidden">

                        <ui:Label
                            name="privacy-section-6-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SECTION 7 -->
                <ui:VisualElement
                    name="privacy-section-7"
                    class="privacy-section">

                    <ui:Button
                        name="privacy-section-7-button"
                        class="privacy-section-header">

                        <ui:Label
                            name="privacy-section-7-title"
                            text="7. Cookie Policy"
                            class="privacy-section-title"/>

                        <!-- Arrow uses arrow-down.png / arrow-up.png (switched by USS class) -->
                        <ui:VisualElement
                            name="privacy-section-7-arrow"
                            class="privacy-section-arrow"
                            picking-mode="Ignore">
                            <ui:VisualElement
                                class="privacy-section-arrow-icon"
                                picking-mode="Ignore"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <ui:VisualElement
                        name="privacy-section-7-content"
                        class="privacy-section-content privacy-section-content-hidden">

                        <ui:Label
                            name="privacy-section-7-body"
                            text=""
                            class="privacy-section-body"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="privacy-scroll-bottom-space"/>

            </ui:VisualElement>
        </ui:ScrollView>

        <!-- FIXED CONSENT PANEL -->
        <ui:VisualElement
            name="privacy-consent-panel"
            class="privacy-consent-panel">

            <ui:VisualElement class="privacy-consent-row">
                <ui:Toggle
                    name="privacy-consent-toggle"
                    text="I have read and understood the policy"
                    class="privacy-consent-toggle"/>
            </ui:VisualElement>

            <ui:Button
                name="accept-continue-button"
                text="Accept &amp; Continue"
                class="accept-continue-button"/>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
