<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <Style src="AR_HUD.uss" />

    <engine:VisualElement name="root" class="root-container">
        <!-- Top Bar -->
        <engine:VisualElement name="top-bar" class="top-bar">
            <engine:Button name="back-button" class="back-btn">
                <engine:VisualElement class="btn-icon icon-back" />
            </engine:Button>

            <engine:Button name="menu-button" class="menu-btn">
                <engine:VisualElement class="btn-icon icon-menu" />
            </engine:Button>
        </engine:VisualElement>

        <!-- Menu -->
        <engine:VisualElement name="menu-panel" class="menu-panel hidden">
            <engine:Button name="toggle-visibility-btn" class="sub-menu-btn">
                <engine:VisualElement name="visibility-icon" class="btn-icon" />
            </engine:Button>

            <engine:Button name="toggle-rotate-btn" class="sub-menu-btn">
                <engine:VisualElement name="rotate-icon" class="btn-icon" />
            </engine:Button>

            <engine:Button name="model-list-btn" class="sub-menu-btn">
                <engine:VisualElement name="model-list-icon" class="btn-icon" />
            </engine:Button>
        </engine:VisualElement>

        <!-- Loading / Error -->
        <engine:VisualElement name="loading-panel" class="loading-panel hidden">
            <engine:Label name="loading-label" text="Đang tải mô hình 3D..." class="loading-label" />
        </engine:VisualElement>

        <!-- Popup danh sách model của lesson -->
        <engine:VisualElement name="model-popup" class="popup-overlay hidden">
            <engine:VisualElement class="popup-card">
                <engine:VisualElement class="popup-header">
                    <engine:Label text="Mô Hình 3D Trong Lớp" class="popup-title" />
                    <engine:Button name="close-popup-btn" class="popup-close-btn">
                        <engine:Label text="X" class="popup-close-text" />
                    </engine:Button>
                </engine:VisualElement>

                <engine:ScrollView name="model-scroll-view" class="model-scroll-view" vertical-scroller-visibility="Hidden">
                    <engine:VisualElement name="model-list-container" />
                </engine:ScrollView>

                <!-- Teacher-only controls -->
                <engine:VisualElement name="teacher-model-actions" class="teacher-model-actions hidden">
                    <engine:Button name="teacher-edit-models-btn" text="Chỉnh sửa" class="teacher-action-btn" />
                    <engine:Button name="teacher-done-models-btn" text="Hoàn tất" class="teacher-action-btn" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- Teacher add model popup -->
        <engine:VisualElement name="add-model-popup" class="popup-overlay hidden">
            <engine:VisualElement class="add-model-card">
                <engine:VisualElement class="popup-header">
                    <engine:Label text="Thêm mô hình 3D" class="popup-title" />
                    <engine:Button name="close-add-model-btn" class="popup-close-btn">
                        <engine:Label text="X" class="popup-close-text" />
                    </engine:Button>
                </engine:VisualElement>

                <engine:Label text="Chọn file" class="add-model-field-title" />
                <engine:Button name="choose-model-file-btn" text="Chọn file GLB" class="add-model-file-btn" />
                <engine:Label name="selected-model-file-label" text="Chưa chọn file" class="add-model-file-name" />

                <engine:Label text="Thêm vào" class="add-model-field-title add-model-field-gap" />
                <engine:DropdownField name="target-lesson-dropdown" class="add-model-dropdown" />

                <engine:Label name="add-model-error-label" text="" class="add-model-error-label hidden" />

                <engine:Button name="confirm-add-model-btn" text="Thêm" class="add-model-submit-btn" />

                <engine:VisualElement name="upload-progress-row" class="upload-progress-row hidden">
                    <engine:Label name="upload-spinner-label" text="◐" class="upload-spinner-label" />
                    <engine:Label name="upload-progress-label" text="Đang tải mô hình..." class="upload-progress-label" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
