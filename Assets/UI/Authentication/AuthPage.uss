.auth-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(246, 248, 252);
    color: rgb(20, 37, 76);
    -unity-font-definition: resource("Fonts/Inter_24pt-Regular");
}

.auth-scroll {
    flex-grow: 1;
}

.auth-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

.auth-scroll .unity-scroller,
.auth-scroll .unity-scroll-view__vertical-scroller,
.auth-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
}

.auth-scroll .unity-scroll-view__content-viewport {
    margin-right: 0;
    margin-bottom: 0;
}

/* ICON PATHS */
.icon-graduation {
    background-image: url("project://database/Assets/UI/Images/Icons/graduation-cap-white.png");
}

.icon-teacher {
    background-image: url("project://database/Assets/UI/Images/Icons/teacher.png");
}

.icon-student {
    background-image: url("project://database/Assets/UI/Images/Icons/student.png");
}

.icon-globe {
    background-image: url("project://database/Assets/UI/Images/Icons/globe.png");
}

.icon-lock {
    background-image: url("project://database/Assets/UI/Images/Icons/lock.png");
}

.icon-eye {
    background-image: url("project://database/Assets/UI/Images/Icons/eye.png");
}

.icon-eye-off {
    background-image: url("project://database/Assets/UI/Images/Icons/eye-off.png");
}

.icon-google {
    background-image: url("project://database/Assets/UI/Images/Icons/google.png");
}

.logo-icon,
.role-icon,
.input-icon,
.eye-icon,
.social-icon {
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

/* HERO */
.login-hero {
    position: relative;
    height: 276px;
    align-items: center;
    justify-content: center;
    background-color: rgb(4, 74, 187);
    overflow: hidden;
}

.hero-circle {
    position: absolute;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 1000px;
}

.hero-circle-large {
    width: 390px;
    height: 390px;
    top: -95px;
    left: 25px;
}

.hero-circle-medium {
    width: 290px;
    height: 290px;
    top: -45px;
    left: 75px;
}

.hero-circle-small {
    width: 190px;
    height: 190px;
    top: 5px;
    left: 125px;
}

.logo-container {
    position: relative;
    align-items: center;
    margin-top: 12px;
}

.logo-icon-container {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 18px;
}

.logo-icon {
    width: 42px;
    height: 42px;
}

.logo-title {
    margin-bottom: 4px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
}

.logo-subtitle {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
}

/* CARD + TABS */
.auth-card {
    position: relative;
    margin-top: -32px;
    margin-right: 20px;
    margin-left: 20px;
    padding-bottom: 24px;
    background-color: white;
    border-radius: 24px;
    overflow: hidden;
}

.tab-header {
    height: 64px;
    flex-direction: row;
}

.tab-button {
    flex-grow: 1;
    height: 64px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(91, 99, 125);
}

.tab-button-active {
    color: rgb(0, 70, 180);
    border-bottom-width: 3px;
    border-bottom-color: rgb(0, 70, 180);
}

.tab-divider {
    height: 1px;
    background-color: rgb(224, 230, 241);
}

.form-content {
    padding-top: 24px;
    padding-right: 24px;
    padding-left: 24px;
}

.form-hidden {
    display: none;
}

.field-heading {
    margin-bottom: 11px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(65, 78, 112);
}

/* ROLE */
.role-row {
    flex-direction: row;
    margin-bottom: 18px;
}

.role-button {
    flex-grow: 1;
    height: 49px;
    padding: 0;
    background-color: rgb(249, 251, 255);
    border-width: 2px;
    border-color: rgb(220, 227, 241);
    border-radius: 20px;
}

.role-button-left {
    margin-right: 5px;
}

.role-button-right {
    margin-left: 5px;
}

.role-button-active {
    background-color: rgb(242, 247, 255);
    border-color: rgb(0, 70, 180);
}

.role-button-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.role-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-image-tint-color: rgb(79, 93, 127);
}

.role-button-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(79, 93, 127);
}

.role-button-active .role-button-text {
    color: rgb(0, 70, 180);
}

.role-button-active .role-icon {
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

/* INPUT */
.input-container {
    height: 48px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding-right: 13px;
    padding-left: 16px;
    background-color: rgb(237, 243, 254);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 24px;
}

.input-focused {
    border-color: rgb(0, 70, 180);
}

.input-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    margin-right: 9px;
    -unity-background-image-tint-color: rgb(95, 112, 153);
}

.auth-input {
    flex-grow: 1;
    height: 44px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 14px;
    color: rgb(29, 49, 89);
}

.auth-input .unity-text-field__input {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    padding: 0;
    font-size: 14px;
    color: rgb(29, 49, 89);
}

.eye-button {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    border-radius: 17px;
}

.eye-wrapper {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.eye-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(95, 112, 153);
}

/* REMEMBER */
.option-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 1px;
    margin-bottom: 18px;
}

.remember-button {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
}

.remember-checkbox {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    background-color: white;
    border-width: 2px;
    border-color: rgb(211, 221, 240);
    border-radius: 4px;
}

.remember-checkbox-checked {
    background-color: rgb(0, 70, 180);
    border-color: rgb(0, 70, 180);
}

.remember-checkmark {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.remember-checkmark-hidden {
    display: none;
}

.remember-label {
    font-size: 13px;
    color: rgb(79, 93, 127);
}

.link-button {
    height: 28px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

/* PRIMARY ACTION */
.primary-action-button {
    width: 100%;
    height: 50px;
    margin-bottom: 20px;
    background-color: rgb(0, 70, 180);
    border-width: 0;
    border-radius: 21px;
    font-size: 15px;
    -unity-font-style: bold;
    color: white;
}

.primary-action-button:hover {
    background-color: rgb(0, 58, 155);
}

.primary-action-button:active {
    background-color: rgb(0, 48, 132);
}

.register-action-button {
    margin-top: 1px;
}

/* SOCIAL */
.social-divider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.social-divider {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(218, 226, 240);
}

.social-divider-text {
    margin-right: 12px;
    margin-left: 12px;
    font-size: 13px;
    color: rgb(112, 124, 153);
}

.social-button {
    width: 100%;
    height: 46px;
    padding: 0;
    margin-bottom: 20px;
    background-color: white;
    border-width: 1px;
    border-color: rgb(218, 226, 240);
    border-radius: 23px;
}

.social-button-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.social-icon {
    width: 19px;
    height: 19px;
    margin-right: 9px;
}

.social-button-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(29, 49, 89);
}

/* PRIVACY */
.privacy-button {
    align-self: center;
    height: 28px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgb(79, 93, 127);
}

.page-bottom-space {
    height: 80px;
}

/* AUTH MESSAGE: dùng chung cho Login và Register */
.auth-message {
    display: none;
    min-height: 18px;
    margin-top: -6px;
    margin-bottom: 10px;
    padding-right: 6px;
    padding-left: 6px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.auth-message--error {
    display: flex;
    color: rgb(210, 45, 45);
}

.auth-message--success {
    display: flex;
    color: rgb(35, 145, 80);
}

.auth-message--loading {
    display: flex;
    color: rgb(79, 93, 127);
}