/* ============================================================
   VRPage.uss
   Fixed icon assets + perfectly aligned vertical buttons
   ============================================================ */

.vr-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Every top control uses EXACTLY the same dimensions. */
.vr-circle-button {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;

    padding: 0;
    margin: 0;

    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(70, 80, 95, 0.20);
    background-color: rgba(255, 255, 255, 0.97);

    align-items: center;
    justify-content: center;

    flex-shrink: 0;
}

.vr-circle-button:active {
    scale: 0.95;
}

/* Same icon box for ALL controls. */
.vr-button-icon {
    width: 23px;
    height: 23px;

    min-width: 23px;
    min-height: 23px;
    max-width: 23px;
    max-height: 23px;

    -unity-background-scale-mode: scale-to-fit;
}

/* ------------------------------------------------------------
   Back
   ------------------------------------------------------------ */

.vr-back-button {
    position: absolute;
    left: 20px;
    top: 52px;
}

.back-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/back.png');
}

/* ------------------------------------------------------------
   Top-right vertical menu

   IMPORTANT:
   All four buttons have the SAME x position.
   No individual right/left offset is used.
   ------------------------------------------------------------ */

.vertical-menu-root {
    position: absolute;

    right: 20px;
    top: 52px;

    width: 48px;

    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.menu-item {
    position: relative;

    width: 48px;
    height: 48px;

    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;

    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 8px;
}

/* Use the REAL PNG assets instead of text glyphs. */
.menu-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/menu.png');
}

.models-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/dots-menu.png');
}

.eye-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/eye.png');
}

.eye-off-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/eye-off.png');
}

.rotate-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/rotate.png');
}

.no-rotate-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/no-rotate.png');
}

.menu-hidden {
    display: none;
}

.model-loading-label {
    position: absolute;
    left: 50%;
    top: 52%;
    translate: -50% -50%;
    padding-top: 9px;
    padding-right: 14px;
    padding-bottom: 9px;
    padding-left: 14px;
    border-radius: 14px;
    background-color: rgba(20, 30, 45, 0.82);
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.model-browser-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 96px;
    padding-bottom: 72px;
    background-color: rgba(15, 24, 38, 0.42);
    align-items: center;
    justify-content: center;
}

.model-browser-panel {
    width: 100%;
    max-width: 620px;
    height: 100%;
    max-height: 720px;
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(210, 218, 230, 0.95);
    background-color: rgba(255, 255, 255, 0.985);
}

.browser-header {
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.browser-heading {
    flex-grow: 1;
    min-width: 0;
    padding-left: 8px;
    padding-right: 8px;
}

.browser-title {
    font-size: 19px;
    color: rgb(20, 35, 58);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.browser-subtitle {
    margin-top: 2px;
    font-size: 11px;
    color: rgb(100, 115, 138);
    white-space: nowrap;
    overflow: hidden;
}

.browser-header-button {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    padding: 0;
    border-radius: 21px;
    border-width: 1px;
    border-color: rgba(80, 95, 120, 0.15);
    background-color: rgb(245, 248, 252);
    color: rgb(26, 42, 68);
    font-size: 26px;
    -unity-text-align: middle-center;
}

.browser-list {
    flex-grow: 1;
}

.browser-row {
    width: 100%;
    min-height: 70px;
    margin-bottom: 9px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    flex-direction: row;
    align-items: center;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(222, 228, 237);
    background-color: rgb(248, 250, 253);
}

.browser-row-current {
    border-color: rgb(90, 145, 220);
    background-color: rgb(240, 247, 255);
}

.browser-row-info {
    flex-grow: 1;
    min-width: 0;
    align-items: flex-start;
    justify-content: center;
}

.browser-row-eyebrow {
    margin-bottom: 3px;
    font-size: 10px;
    color: rgb(91, 115, 150);
    -unity-font-style: bold;
}

.browser-row-title {
    max-width: 100%;
    font-size: 14px;
    color: rgb(24, 40, 66);
    -unity-font-style: bold;
    white-space: normal;
}

.browser-row-count {
    margin-left: 8px;
    padding-top: 5px;
    padding-right: 8px;
    padding-bottom: 5px;
    padding-left: 8px;
    border-radius: 10px;
    background-color: rgb(231, 238, 248);
    color: rgb(69, 92, 126);
    font-size: 10px;
}

.model-row {
    width: 100%;
    min-height: 68px;
    margin-bottom: 9px;
    padding-top: 9px;
    padding-right: 11px;
    padding-bottom: 9px;
    padding-left: 11px;
    flex-direction: row;
    align-items: center;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(222, 228, 237);
    background-color: rgb(249, 251, 254);
}

.model-row-selected {
    border-color: rgb(74, 137, 224);
    background-color: rgb(238, 247, 255);
}

.model-row-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    margin-right: 10px;
    background-image: url('project://database/Assets/UI/Images/Icons/cube.png');
    -unity-background-scale-mode: scale-to-fit;
}

.model-row-subtitle {
    margin-top: 2px;
    max-width: 100%;
    font-size: 10px;
    color: rgb(105, 118, 140);
    white-space: nowrap;
    overflow: hidden;
}

.model-row-action {
    margin-left: 8px;
    font-size: 10px;
    color: rgb(43, 105, 198);
    -unity-font-style: bold;
}

.browser-empty {
    min-height: 90px;
    padding: 18px;
    color: rgb(105, 118, 140);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}



/* ============================================================
   AI CHAT - bottom-right button + in-scene chat panel
   ============================================================ */

.ai-chat-fab {
    position: absolute;

    right: 20px;
    bottom: 18px;

    width: 58px;
    height: 58px;

    min-width: 58px;
    min-height: 58px;
    max-width: 58px;
    max-height: 58px;

    padding: 0;

    justify-content: center;
    align-items: center;

    border-width: 0;
    border-radius: 17px;

    background-color: rgb(255, 159, 17);
}

.ai-chat-fab:hover {
    background-color: rgb(237, 140, 0);
}

.ai-chat-fab-icon {
    width: 26px;
    height: 26px;

    background-image: url('project://database/Assets/UI/Images/Icons/ai-sparkle.png');
    -unity-background-scale-mode: scale-to-fit;
}

.ai-chat-overlay {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    padding-left: 14px;
    padding-right: 14px;
    padding-top: 120px;
    padding-bottom: 96px;

    background-color: rgba(10, 18, 32, 0.34);

    align-items: center;
    justify-content: flex-end;
}

.ai-chat-panel {
    width: 100%;
    max-width: 620px;
    height: 68%;
    min-height: 330px;

    padding: 12px;

    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(220, 226, 235, 0.92);

    background-color: rgba(255, 255, 255, 0.985);
}

.ai-chat-header {
    min-height: 50px;

    flex-direction: row;
    align-items: center;

    margin-bottom: 8px;
}

.ai-chat-title-group {
    flex-grow: 1;
    min-width: 0;
}

.ai-chat-title {
    font-size: 16px;
    color: rgb(26, 42, 68);

    -unity-font-style: bold;
}

.ai-chat-context {
    margin-top: 2px;

    font-size: 10px;
    color: rgb(104, 119, 143);

    white-space: nowrap;
    overflow: hidden;
}

.ai-chat-close {
    width: 38px;
    height: 38px;

    min-width: 38px;
    min-height: 38px;

    padding: 0;

    border-radius: 19px;
    border-width: 0;

    background-color: rgb(242, 245, 249);

    color: rgb(42, 57, 80);
    font-size: 23px;

    -unity-text-align: middle-center;
}

.ai-chat-messages {
    flex-grow: 1;

    margin-bottom: 8px;

    border-radius: 12px;

    background-color: rgb(247, 249, 252);
}

.ai-chat-message-container {
    padding: 8px;
}

.ai-chat-row {
    width: 100%;

    margin-top: 4px;
    margin-bottom: 4px;

    flex-direction: row;
}

.ai-chat-row-user {
    justify-content: flex-end;
}

.ai-chat-row-assistant {
    justify-content: flex-start;
}

.ai-chat-bubble {
    max-width: 82%;

    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;

    border-radius: 13px;

    white-space: normal;

    font-size: 11px;
}

.ai-chat-bubble-user {
    background-color: rgb(32, 105, 210);
    color: rgb(255, 255, 255);
}

.ai-chat-bubble-assistant {
    background-color: rgb(235, 239, 245);
    color: rgb(32, 45, 65);
}

.ai-chat-typing {
    margin-left: 4px;
    margin-bottom: 5px;

    color: rgb(105, 119, 140);
    font-size: 10px;
}

.ai-chat-composer {
    min-height: 46px;

    flex-direction: row;
    align-items: center;
}

.ai-chat-input {
    flex-grow: 1;

    min-height: 42px;

    margin-right: 8px;

    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(216, 223, 234);

    background-color: rgb(248, 250, 253);

    font-size: 12px;
    color: rgb(28, 42, 62);
}

.ai-chat-send {
    width: 42px;
    height: 42px;

    min-width: 42px;
    min-height: 42px;

    padding: 0;

    border-radius: 21px;
    border-width: 0;

    background-color: rgb(249, 158, 18);

    align-items: center;
    justify-content: center;
}

.ai-chat-send-icon {
    width: 19px;
    height: 19px;

    background-image: url('project://database/Assets/UI/Images/Icons/send-white.png');
    -unity-background-scale-mode: scale-to-fit;
}



/* ============================================================
   AI MODEL DETAIL MODE
   ============================================================ */

.details-icon {
    background-image: url('project://database/Assets/UI/Images/Icons/atom.png');
}

.detail-menu-active {
    background-color: rgb(232, 244, 255);
    border-color: rgb(74, 137, 224);
}

.detail-connector-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.detail-labels-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.detail-part-label {
    position: absolute;

    min-width: 104px;
    max-width: 165px;
    min-height: 34px;

    padding-top: 7px;
    padding-right: 11px;
    padding-bottom: 7px;
    padding-left: 11px;

    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(86, 134, 201, 0.78);

    background-color: rgba(255, 255, 255, 0.96);

    color: rgb(25, 47, 77);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    white-space: normal;
}

.detail-part-label:hover {
    background-color: rgb(240, 247, 255);
    border-color: rgb(59, 119, 204);
}

.detail-part-label:active {
    scale: 0.97;
}

.detail-popup-overlay {
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    /* Keep a small safe margin around the sheet. */
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 72px;
    padding-bottom: 64px;

    background-color: rgba(12, 20, 34, 0.42);

    align-items: center;
    justify-content: flex-end;
}

.detail-popup-panel {
    width: 100%;
    max-width: 620px;

    /* About 3/4 of the phone scene. */
    height: 74%;
    max-height: 74%;
    min-height: 0;

    padding-top: 16px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 16px;

    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(214, 223, 235, 0.96);

    background-color: rgba(255, 255, 255, 0.99);

    overflow: hidden;
}

.detail-popup-header {
    min-height: 62px;

    flex-direction: row;
    align-items: center;

    margin-bottom: 10px;

    flex-shrink: 0;
}

.detail-popup-heading {
    flex-grow: 1;
    min-width: 0;
    padding-right: 10px;
}

.detail-popup-title {
    font-size: 21px;
    color: rgb(20, 39, 66);
    -unity-font-style: bold;
    white-space: normal;
}

.detail-popup-confidence {
    margin-top: 4px;
    font-size: 11px;
    color: rgb(76, 111, 158);
    -unity-font-style: bold;
}

.detail-popup-close {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;

    padding: 0;

    border-radius: 20px;
    border-width: 0;

    background-color: rgb(241, 245, 250);

    color: rgb(40, 56, 80);
    font-size: 24px;
    -unity-text-align: middle-center;
}

.detail-popup-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;

    /* No visual space reserved for a scrollbar. */
    padding-right: 0;
    padding-bottom: 10px;

    overflow: hidden;
}

/*
 * Hide the visual vertical scrollbar only.
 * The ScrollView itself is still active, so mouse drag / touch swipe /
 * mouse wheel scrolling continues to work normally.
 */
.detail-popup-scroll .unity-scroll-view__vertical-scroller,
.detail-popup-scroll .unity-scroller--vertical {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

/*
 * Keep the ScrollView content attached to the top. Combined with
 * TouchScrollBehavior.Clamped in C#, this prevents the large empty gap
 * visible when the user drags downward.
 */
.detail-popup-scroll .unity-scroll-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
}

.detail-section-title {
    margin-top: 16px;
    margin-bottom: 6px;

    color: rgb(43, 92, 160);
    font-size: 12px;
    -unity-font-style: bold;
}

.detail-section-body {
    margin-bottom: 12px;

    color: rgb(39, 51, 68);
    font-size: 13px;

    white-space: normal;
    flex-grow: 0;
    flex-shrink: 0;
}

.hidden {
    display: none;
}


/* =========================================================
   AI CHAT - FORCE HIDE INTERNAL SCROLLBARS
   Keep drag/wheel scrolling, but remove the visible track,
   thumb and arrow buttons in Unity 6 UI Toolkit.
   ========================================================= */
.ai-chat-messages .unity-scroll-view__vertical-scroller,
.ai-chat-messages .unity-scroll-view__horizontal-scroller,
.ai-chat-messages .unity-scroller--vertical,
.ai-chat-messages .unity-scroller--horizontal {
    display: none;
    width: 0;
    min-width: 0;
    max-width: 0;
    height: 0;
    min-height: 0;
    max-height: 0;
}

.ai-chat-messages .unity-scroll-view__content-viewport {
    margin-right: 0;
    padding-right: 0;
}
