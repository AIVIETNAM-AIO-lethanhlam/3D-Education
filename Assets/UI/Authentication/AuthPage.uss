.auth-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(246, 248, 252);
    color: rgb(20, 37, 76);
    -unity-font-definition: resource("Fonts/Inter_24pt-Regular");
}

.auth-scroll {
    flex-grow: 1;
}

.auth-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

.auth-scroll .unity-scroller,
.auth-scroll .unity-scroll-view__vertical-scroller,
.auth-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
}

.auth-scroll .unity-scroll-view__content-viewport {
    margin-right: 0;
    margin-bottom: 0;
}

/* ICON PATHS */
.icon-graduation {
    background-image: url("project://database/Assets/UI/Images/Icons/graduation-cap-white.png");
}

.icon-teacher {
    background-image: url("project://database/Assets/UI/Images/Icons/teacher.png");
}

.icon-student {
    background-image: url("project://database/Assets/UI/Images/Icons/student.png");
}

.icon-globe {
    background-image: url("project://database/Assets/UI/Images/Icons/globe.png");
}

.icon-lock {
    background-image: url("project://database/Assets/UI/Images/Icons/lock.png");
}

.icon-eye {
    background-image: url("project://database/Assets/UI/Images/Icons/eye.png");
}

.icon-eye-off {
    background-image: url("project://database/Assets/UI/Images/Icons/eye-off.png");
}

.icon-google {
    background-image: url("project://database/Assets/UI/Images/Icons/google.png");
}

.logo-icon,
.role-icon,
.input-icon,
.eye-icon,
.social-icon {
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

/* HERO */
.login-hero {
    position: relative;
    height: 276px;
    align-items: center;
    justify-content: center;
    background-color: rgb(4, 74, 187);
    overflow: hidden;
}

.hero-circle {
    position: absolute;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 1000px;
}

.hero-circle-large {
    width: 390px;
    height: 390px;
    top: -95px;
    left: 25px;
}

.hero-circle-medium {
    width: 290px;
    height: 290px;
    top: -45px;
    left: 75px;
}

.hero-circle-small {
    width: 190px;
    height: 190px;
    top: 5px;
    left: 125px;
}

.logo-container {
    position: relative;
    align-items: center;
    margin-top: 12px;
}

.logo-icon-container {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 18px;
}

.logo-icon {
    width: 42px;
    height: 42px;
}

.logo-title {
    margin-bottom: 4px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
}

.logo-subtitle {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
}

/* CARD + TABS */
.auth-card {
    position: relative;
    margin-top: -32px;
    margin-right: 20px;
    margin-left: 20px;
    padding-bottom: 24px;
    background-color: white;
    border-radius: 24px;
    overflow: hidden;
}

.tab-header {
    height: 64px;
    flex-direction: row;
}

.tab-button {
    flex-grow: 1;
    height: 64px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(91, 99, 125);
}

.tab-button-active {
    color: rgb(0, 70, 180);
    border-bottom-width: 3px;
    border-bottom-color: rgb(0, 70, 180);
}

.tab-divider {
    height: 1px;
    background-color: rgb(224, 230, 241);
}

.form-content {
    padding-top: 24px;
    padding-right: 24px;
    padding-left: 24px;
}

.form-hidden {
    display: none;
}

.field-heading {
    margin-bottom: 11px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(65, 78, 112);
}

/* ROLE */
.role-row {
    flex-direction: row;
    margin-bottom: 18px;
}

.role-button {
    flex-grow: 1;
    height: 49px;
    padding: 0;
    background-color: rgb(249, 251, 255);
    border-width: 2px;
    border-color: rgb(220, 227, 241);
    border-radius: 20px;
}

.role-button-left {
    margin-right: 5px;
}

.role-button-right {
    margin-left: 5px;
}

.role-button-active {
    background-color: rgb(242, 247, 255);
    border-color: rgb(0, 70, 180);
}

.role-button-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.role-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-image-tint-color: rgb(79, 93, 127);
}

.role-button-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(79, 93, 127);
}

.role-button-active .role-button-text {
    color: rgb(0, 70, 180);
}

.role-button-active .role-icon {
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

/* INPUT */
.input-container {
    height: 48px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding-right: 13px;
    padding-left: 16px;
    background-color: rgb(237, 243, 254);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 24px;
}

.input-focused {
    border-color: rgb(0, 70, 180);
}

.input-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    margin-right: 9px;
    -unity-background-image-tint-color: rgb(95, 112, 153);
}

.auth-input {
    flex-grow: 1;
    height: 44px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 14px;
    color: rgb(29, 49, 89);
}

.auth-input .unity-text-field__input {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    padding: 0;
    font-size: 14px;
    color: rgb(29, 49, 89);
}

/* Real placeholder styling for UI Toolkit TextField.
   Typed text stays dark; only the hint is light gray. */
.auth-input .unity-base-text-field__input--placeholder {
    color: rgb(148, 163, 184);
}

.eye-button {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    border-radius: 17px;
}

.eye-wrapper {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.eye-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(95, 112, 153);
}

/* REMEMBER */
.option-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 1px;
    margin-bottom: 18px;
}

.remember-button {
    height: 30px;
    flex-direction: row;
    align-items: center;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
}

.remember-checkbox {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    background-color: white;
    border-width: 2px;
    border-color: rgb(211, 221, 240);
    border-radius: 4px;
}

.remember-checkbox-checked {
    background-color: rgb(0, 70, 180);
    border-color: rgb(0, 70, 180);
}

.remember-checkmark {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.remember-checkmark-hidden {
    display: none;
}

.remember-label {
    font-size: 13px;
    color: rgb(79, 93, 127);
}

.link-button {
    height: 28px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

/* PRIMARY ACTION */
.primary-action-button {
    width: 100%;
    height: 50px;
    margin-bottom: 20px;
    background-color: rgb(0, 70, 180);
    border-width: 0;
    border-radius: 21px;
    font-size: 15px;
    -unity-font-style: bold;
    color: white;
}

.primary-action-button:hover {
    background-color: rgb(0, 58, 155);
}

.primary-action-button:active {
    background-color: rgb(0, 48, 132);
}

.register-action-button {
    margin-top: 1px;
}

/* SOCIAL */
.social-divider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.social-divider {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(218, 226, 240);
}

.social-divider-text {
    margin-right: 12px;
    margin-left: 12px;
    font-size: 13px;
    color: rgb(112, 124, 153);
}

.social-button {
    width: 100%;
    height: 46px;
    padding: 0;
    margin-bottom: 20px;
    background-color: white;
    border-width: 1px;
    border-color: rgb(218, 226, 240);
    border-radius: 23px;
}

.social-button-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.social-icon {
    width: 19px;
    height: 19px;
    margin-right: 9px;
}

.social-button-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(29, 49, 89);
}

/* PRIVACY */
.privacy-button {
    align-self: center;
    height: 28px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgb(79, 93, 127);
}

.page-bottom-space {
    height: 80px;
}

/* AUTH MESSAGE: dùng chung cho Login và Register */
.auth-message {
    display: none;
    min-height: 18px;
    margin-top: -6px;
    margin-bottom: 10px;
    padding-right: 6px;
    padding-left: 6px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.auth-message--error {
    display: flex;
    color: rgb(210, 45, 45);
}

.auth-message--success {
    display: flex;
    color: rgb(35, 145, 80);
}

.auth-message--loading {
    display: flex;
    color: rgb(79, 93, 127);
}
/* ================================================================
   PASSWORD RECOVERY
   Forgot Password -> OTP -> New Password -> Success
   ================================================================ */

.recovery-back-button,
.recovery-status-dots {
    display: none;
}

.recovery-active .login-hero {
    height: 198px;
    justify-content: flex-start;
}

.recovery-active .logo-container {
    margin-top: 48px;
}

.recovery-active .logo-icon-container {
    width: 50px;
    height: 50px;
    margin-bottom: 8px;
    border-radius: 14px;
}

.recovery-active .logo-icon {
    width: 29px;
    height: 29px;
}

.recovery-active .logo-title {
    margin-bottom: 2px;
    font-size: 16px;
}

.recovery-active .logo-subtitle {
    font-size: 11px;
}

.recovery-active .auth-card {
    margin-top: -29px;
    padding-bottom: 0;
    border-width: 1px;
    border-color: rgb(225, 232, 244);
    border-radius: 22px;
}

.recovery-active .tab-header,
.recovery-active .tab-divider {
    display: none;
}

.recovery-active .page-bottom-space {
    height: 36px;
}

.recovery-back-button {
    position: absolute;
    top: 32px;
    left: 13px;
    width: 35px;
    height: 35px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.13);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 18px;
    font-size: 20px;
    -unity-font-style: bold;
    color: white;
}

.recovery-active .recovery-back-button {
    display: flex;
}

.recovery-status-dots {
    position: absolute;
    top: 35px;
    right: 16px;
    flex-direction: row;
    align-items: center;
}

.recovery-active .recovery-status-dots {
    display: flex;
}

.recovery-status-dot {
    margin-left: 3px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
}

.recovery-status-dot-main {
    color: white;
}

.recovery-form {
    padding-top: 22px;
    padding-right: 18px;
    padding-bottom: 26px;
    padding-left: 18px;
    align-items: stretch;
}

.recovery-form-reset {
    padding-top: 21px;
    padding-bottom: 18px;
}

.recovery-icon-badge {
    align-self: center;
    width: 50px;
    height: 50px;
    margin-bottom: 15px;
    align-items: center;
    justify-content: center;
    background-color: rgb(241, 246, 255);
    border-width: 1px;
    border-color: rgb(198, 216, 245);
    border-radius: 14px;
}

.recovery-main-icon {
    width: 23px;
    height: 23px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(0, 70, 180);
}

.recovery-symbol-icon {
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

.recovery-title {
    margin-bottom: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(13, 30, 66);
}

.recovery-description {
    align-self: center;
    max-width: 290px;
    margin-bottom: 23px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(85, 102, 140);
}

.recovery-description-tight {
    margin-bottom: 3px;
}

.recovery-masked-email {
    align-self: center;
    margin-bottom: 22px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

.recovery-field-heading {
    margin-bottom: 8px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(67, 82, 117);
}

.recovery-input-container {
    height: 46px;
    margin-bottom: 8px;
    background-color: rgb(239, 244, 254);
    border-color: rgb(194, 211, 241);
    border-radius: 19px;
}

.input-error {
    border-width: 1px;
    border-color: rgb(239, 68, 68);
}

.input-success {
    border-width: 1px;
    border-color: rgb(34, 197, 94);
}

.recovery-message {
    min-height: 0;
    margin-top: 0;
    margin-bottom: 8px;
    padding-right: 4px;
    padding-left: 4px;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-left;
    color: rgba(0, 0, 0, 0);
}

.recovery-message-centered {
    -unity-text-align: middle-center;
}

.recovery-message--error {
    color: rgb(239, 68, 68);
}

.recovery-message--success {
    color: rgb(22, 163, 74);
}

.recovery-message--info {
    color: rgb(82, 101, 139);
}

.recovery-primary-button {
    height: 48px;
    margin-top: 2px;
    margin-bottom: 18px;
    border-radius: 18px;
}

.primary-action-button:disabled {
    background-color: rgb(129, 164, 220);
    color: rgba(255, 255, 255, 0.92);
}

.recovery-inline-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 17px;
}

.recovery-inline-text {
    margin-right: 3px;
    font-size: 10px;
    color: rgb(101, 115, 147);
}

.recovery-inline-link {
    height: 26px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

.recovery-security-note {
    min-height: 42px;
    flex-direction: row;
    align-items: flex-start;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgb(223, 230, 243);
}

.recovery-security-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    margin-top: 2px;
    margin-right: 7px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(112, 130, 167);
}

.recovery-security-text {
    flex-grow: 1;
    font-size: 9px;
    white-space: normal;
    color: rgb(112, 126, 157);
}

/* OTP */
.otp-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 11px;
}

.otp-input {
    flex-grow: 1;
    height: 50px;
    margin-right: 6px;
    background-color: rgb(239, 244, 254);
    border-width: 1px;
    border-color: rgb(194, 211, 241);
    border-radius: 16px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(15, 37, 81);
}

.otp-input-last {
    margin-right: 0;
}

.otp-input .unity-text-field__input {
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(15, 37, 81);
}

.otp-input:focus,
.otp-input--filled {
    border-color: rgb(0, 70, 180);
}

.recovery-help-text {
    align-self: center;
    margin-top: 0;
    margin-bottom: 2px;
    font-size: 10px;
    color: rgb(101, 115, 147);
}

.recovery-resend-button {
    align-self: center;
    height: 25px;
    padding: 0;
    margin-bottom: 13px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

.recovery-resend-button:disabled {
    color: rgb(98, 113, 145);
}

.recovery-secondary-link {
    align-self: center;
    height: 31px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(0, 70, 180);
}

/* Password rules */
.password-rules-card {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
    margin-bottom: 16px;
    padding-top: 9px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    background-color: rgb(239, 244, 254);
    border-width: 1px;
    border-color: rgb(194, 211, 241);
    border-radius: 17px;
}

.password-rule {
    width: 50%;
    min-height: 23px;
    flex-direction: row;
    align-items: center;
}

.password-rule-icon {
    width: 17px;
    margin-right: 4px;
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgb(176, 191, 218);
}

.password-rule-text {
    flex-grow: 1;
    font-size: 9px;
    color: rgb(142, 156, 184);
}

.password-rule--valid .password-rule-icon {
    color: rgb(34, 197, 94);
}

.password-rule--valid .password-rule-text {
    color: rgb(20, 37, 76);
}

.recovery-confirm-heading {
    margin-top: 0;
}

.recovery-confirm-input {
    margin-bottom: 2px;
}

.password-match-label {
    min-height: 16px;
    margin-bottom: 3px;
    padding-left: 4px;
    font-size: 9px;
    color: rgba(0, 0, 0, 0);
}

.password-match--success {
    color: rgb(22, 163, 74);
}

.password-match--error {
    color: rgb(239, 68, 68);
}

.recovery-reset-button {
    margin-top: 1px;
    margin-bottom: 0;
}

/* Success */
.recovery-success-form {
    min-height: 365px;
    justify-content: center;
    padding-right: 22px;
    padding-left: 22px;
}

.success-icon-badge {
    align-self: center;
    width: 72px;
    height: 72px;
    margin-bottom: 20px;
    align-items: center;
    justify-content: center;
    background-color: rgb(236, 253, 245);
    border-width: 2px;
    border-color: rgb(134, 239, 172);
    border-radius: 36px;
}

.success-icon-symbol {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(34, 197, 94);
}

.success-title {
    font-size: 19px;
}

.success-description {
    margin-bottom: 20px;
}

.success-security-note {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 22px;
    padding-top: 11px;
    padding-right: 12px;
    padding-bottom: 11px;
    padding-left: 12px;
    background-color: rgb(246, 249, 255);
    border-width: 1px;
    border-color: rgb(223, 230, 243);
    border-radius: 13px;
}

.success-button {
    margin-bottom: 0;
}
