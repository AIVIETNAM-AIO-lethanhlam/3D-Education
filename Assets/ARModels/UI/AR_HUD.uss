/* --- ROOT --- */
.root-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    picking-mode: Ignore;
}

/* --- TOP BAR --- */
.top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 110px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 40px;
    padding-left: 20px;
    padding-right: 20px;
    picking-mode: Ignore;
}

.btn-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: Ignore;
}

.back-btn {
    width: 58px;
    height: 58px;
    border-radius: 29px;
    background-color: #162e51;
    border-width: 0;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.back-btn:hover { background-color: #214373; }
.back-btn:active { background-color: #0d1e36; }

.icon-back {
    background-image: url('Icons/back-white.png');
}

.menu-btn {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background-color: #162e51;
    border-width: 0;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.menu-btn:hover { background-color: #214373; }
.menu-btn:active { background-color: #0d1e36; }

.icon-menu {
    background-image: url('Icons/menu-white.png');
}

/* --- DROP DOWN MENU --- */
.menu-panel {
    position: absolute;
    top: 106px;
    right: 20px;
    width: 58px;
    background-color: #162e51;
    border-radius: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    align-items: center;
    picking-mode: Position;
}

.sub-menu-btn {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background-color: transparent;
    border-width: 0;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 0;
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.sub-menu-btn:hover { background-color: rgba(255, 255, 255, 0.15); }
.sub-menu-btn:active { background-color: rgba(0, 0, 0, 0.2); }

/* --- LOADING / ERROR STATUS --- */
.loading-panel {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 105px;
    min-width: 190px;
    background-color: rgba(22, 46, 81, 0.94);
    border-radius: 14px;
    padding: 12px 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    picking-mode: Ignore;
}

.loading-label {
    color: #ffffff;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* --- MODEL POPUP --- */
.popup-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.65);
    justify-content: center;
    align-items: center;
    picking-mode: Position;
}

.popup-card {
    width: 82%;
    max-width: 360px;
    max-height: 520px;
    background-color: #162e51;
    border-radius: 18px;
    padding: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.popup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    padding-bottom: 12px;
}

.popup-title {
    color: #ffffff;
    font-size: 17px;
    -unity-font-style: bold;
}

.popup-close-btn {
    width: 32px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    border-width: 0;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
}

.popup-close-btn:hover {
    background-color: rgba(255, 85, 85, 0.8);
}

.popup-close-text {
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    picking-mode: Ignore;
}

.model-scroll-view {
    max-height: 340px;
}

.model-item-btn {
    min-height: 50px;
    background-color: #ffffff;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(20, 54, 95, 0.16);
    margin-bottom: 7px;
    padding: 8px 12px;
    justify-content: center;
    align-items: stretch;
}

.model-item-btn:hover {
    background-color: #f2f6fb;
}

.model-item-btn-selected {
    background-color: #2161b5;
    border-color: #4b8df8;
}

.model-item-text-area {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: center;
}

.model-item-name {
    color: #17365d;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    width: 100%;
}

.model-item-state {
    color: #6c7d92;
    font-size: 10px;
    margin-top: 2px;
    -unity-text-align: middle-left;
    width: 100%;
}

.model-empty-label {
    color: rgba(255, 255, 255, 0.78);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding-top: 16px;
    padding-bottom: 16px;
}

.hidden {
    display: none;
}


/* ===== Lesson -> Model dropdown list ===== */
.lesson-model-group {
    margin-bottom: 7px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

.lesson-dropdown-header {
    min-height: 46px;
    padding: 6px 10px;
    margin: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
}

.lesson-dropdown-header:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.lesson-dropdown-text {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-start;
    justify-content: center;
}

.lesson-dropdown-title {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    width: 100%;
}

.lesson-dropdown-count {
    color: rgba(255, 255, 255, 0.64);
    font-size: 9px;
    margin-top: 1px;
    -unity-text-align: middle-left;
    width: 100%;
}

.lesson-dropdown-arrow {
    width: 18px;
    height: 18px;
    min-width: 18px;
    margin-left: 8px;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.lesson-dropdown-arrow-down {
    background-image:
        url("project://database/Assets/UI/Images/Icons/arrow-down-white.png");
}

.lesson-dropdown-arrow-up {
    background-image:
        url("project://database/Assets/UI/Images/Icons/arrow-up-white.png");
}

.lesson-model-items {
    padding: 7px;
    background-color: rgba(5, 17, 34, 0.22);
}

.lesson-model-items .model-item-btn {
    margin-bottom: 6px;
}

.model-item-btn-selected .model-item-name,
.model-item-btn-selected .model-item-state {
    color: #ffffff;
}


/* ===== Teacher controls ===== */
.teacher-model-actions {
    flex-direction: row;
    gap: 8px;
    margin-top: 10px;
}

.teacher-action-btn {
    flex-grow: 1;
    height: 38px;
    border-width: 0;
    border-radius: 9px;
    background-color: #2161b5;
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
}

.teacher-action-btn:hover {
    background-color: #2f73cc;
}

.teacher-action-btn:active {
    background-color: #184d94;
}

/* ===== Add model popup ===== */
.add-model-card {
    width: 84%;
    max-width: 370px;
    background-color: #162e51;
    border-radius: 18px;
    padding: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.add-model-field-title {
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.add-model-field-gap {
    margin-top: 14px;
}

.add-model-file-btn {
    height: 42px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: #ffffff;
    color: #17365d;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 12px;
}

.add-model-file-name {
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    margin-top: 5px;
    white-space: normal;
}

.add-model-dropdown {
    min-height: 42px;
    color: #17365d;
    background-color: #ffffff;
    border-radius: 9px;
}

.add-model-submit-btn {
    height: 42px;
    margin-top: 16px;
    border-width: 0;
    border-radius: 9px;
    background-color: #2161b5;
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}

.add-model-submit-btn:hover {
    background-color: #2f73cc;
}

.add-model-error-label {
    color: #ffb4b4;
    font-size: 10px;
    margin-top: 10px;
    white-space: normal;
}

.upload-progress-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
}

.upload-spinner-label {
    width: 24px;
    color: #ffffff;
    font-size: 19px;
    -unity-text-align: middle-center;
}

.upload-progress-label {
    color: #ffffff;
    font-size: 11px;
    margin-left: 6px;
}
