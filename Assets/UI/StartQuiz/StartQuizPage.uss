.page-root {
    flex-grow: 1;
    background-color: #f8faff;
    position: relative;

    -unity-font-definition: url("project://database/Assets/UI/Fonts/PlusJakartaSans-Regular.ttf");
}

/* =========================
   HEADER
   ========================= */

.header {
    height: 126px;
    padding-top: 48px;
    padding-left: 18px;
    padding-right: 18px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    background-color: #ffffff;
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.back-button {
    width: 42px;
    height: 42px;

    padding: 0;
    margin: 0;

    border-width: 0;
    border-radius: 21px;

    background-color: #f1f5fa;
    align-items: center;
    justify-content: center;
}

.back-button:hover {
    background-color: #e7edf5;
}

.back-button:active {
    background-color: #dce5f0;
}

.back-icon {
    width: 18px;
    height: 18px;

    background-image: url("project://database/Assets/UI/Images/Icons/back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.header-title-group {
    margin-left: 12px;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.lesson-label {
    font-size: 12px;
    color: #9aa8bd;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.header-quiz-title {
    margin-top: 2px;

    font-size: 15px;
    color: #101828;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.status-badge {
    min-width: 110px;
    height: 30px;

    padding-left: 11px;
    padding-right: 11px;

    border-radius: 15px;

    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.status-not-attempted {
    background-color: #f0f4f8;
    border-width: 1px;
    border-color: #e2e8f0;
}

.status-completed {
    background-color: #eafff1;
    border-width: 1px;
    border-color: #8ee5aa;
}

.status-completed .status-dot {
    background-color: #16c766;
}

.status-completed .status-label {
    color: #087c3b;
}

.status-dot {
    width: 7px;
    height: 7px;

    margin-right: 7px;

    border-radius: 4px;
    background-color: #8da0b8;
}

.status-label {
    font-size: 9px;
    letter-spacing: 0.5px;

    color: #64748b;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.header-divider {
    height: 1px;
    background-color: #edf1f6;
}

/* =========================
   SCROLL CONTENT
   ========================= */

.content-scroll {
    flex-grow: 1;
    width: 100%;

    padding-left: 18px;
    padding-right: 18px;
}

.content-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

.content-scroll .unity-scroller--vertical {
    width: 5px;
}

.content-scroll .unity-base-slider__tracker {
    background-color: transparent;
}

.content-scroll .unity-base-slider__dragger {
    min-width: 4px;
    background-color: #cbd5e1;
    border-width: 0;
}

.content-container {
    width: 100%;
    max-width: 470px;

    align-self: center;

    padding-top: 24px;
    padding-bottom: 120px;
}

/* =========================
   QUIZ CARD
   ========================= */

.quiz-card {
    width: 100%;

    background-color: #ffffff;

    border-radius: 18px;
    border-width: 1px;
    border-color: #e3eaf3;

    overflow: hidden;
}

.quiz-card-header {
    min-height: 148px;

    padding-top: 22px;
    padding-bottom: 20px;
    padding-left: 22px;
    padding-right: 22px;

    background-color: #1458c7;
}

.quiz-type-row {
    flex-direction: row;
    align-items: center;
}

.quiz-type-icon-circle {
    width: 36px;
    height: 36px;

    margin-right: 11px;

    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.16);

    align-items: center;
    justify-content: center;
}

.quiz-type-icon {
    width: 18px;
    height: 18px;

    background-image: url("project://database/Assets/UI/Images/Icons/document-white.png");
    -unity-background-scale-mode: scale-to-fit;
}

.quiz-type-label {
    font-size: 10px;
    letter-spacing: 1px;

    color: #bcd4ff;
    -unity-font-style: bold;
}

.quiz-title-label {
    margin-top: 14px;

    font-size: 18px;
    color: #ffffff;
    -unity-font-style: bold;

    white-space: normal;
}

.quiz-subtitle-label {
    margin-top: 4px;

    font-size: 12px;
    color: #b9d1ff;
    -unity-font-style: normal;
}

.quiz-info-container {
    width: 100%;
}

.info-row {
    min-height: 54px;

    padding-left: 22px;
    padding-right: 22px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.info-left {
    min-width: 128px;

    flex-direction: row;
    align-items: center;
}

.info-icon {
    width: 17px;
    height: 17px;

    margin-right: 10px;

    -unity-background-scale-mode: scale-to-fit;
}

.open-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/calendar-green.png");
}

.close-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/calendar-red.png");
}

.empty-icon-space {
    width: 17px;
    height: 17px;
    margin-right: 10px;
}

.info-name {
    font-size: 12px;
    color: #98a6bb;
    -unity-font-style: normal;
}

.info-value {
    flex-grow: 1;

    font-size: 12px;
    color: #172033;
    -unity-font-style: bold;
    -unity-text-align: middle-right;

    white-space: normal;
}

.row-divider {
    height: 1px;
    margin-left: 22px;
    margin-right: 22px;

    background-color: #edf1f5;
}


/* =========================
   ATTEMPT HISTORY - TEMP UI PREVIEW
   Supabase attempt loading is disabled in the controller for now.
   ========================= */

.attempt-history-section {
    width: 100%;
    margin-top: 22px;
}

.attempt-history-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.attempt-history-clock-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;

    background-image: url("project://database/Assets/UI/Images/Icons/clock.png");
    -unity-background-scale-mode: scale-to-fit;
}

.attempt-history-title {
    font-size: 13px;
    letter-spacing: 0.8px;
    color: #5f7391;
    -unity-font-style: bold;
}

.attempt-history-line {
    flex-grow: 1;
    height: 1px;
    margin-left: 10px;
    background-color: #dbe4ef;
}

.attempt-history-container {
    width: 100%;
}

.attempt-card {
    width: 100%;
    margin-bottom: 14px;

    background-color: #ffffff;
    border-width: 1px;
    border-color: #dfe7f1;
    border-radius: 18px;
    overflow: hidden;
}

.attempt-card-header {
    min-height: 56px;
    padding-left: 18px;
    padding-right: 18px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    background-color: #fbfcfe;
    border-bottom-width: 1px;
    border-bottom-color: #edf1f5;
}

.attempt-heading-left {
    flex-direction: row;
    align-items: center;
}

.attempt-number {
    width: 34px;
    height: 34px;
    margin-right: 10px;

    border-radius: 17px;
    background-color: #0f53bd;

    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.attempt-title {
    font-size: 15px;
    color: #111827;
    -unity-font-style: bold;
}

.attempt-status {
    padding-left: 10px;
    padding-right: 10px;
    height: 30px;

    border-radius: 15px;
    background-color: #e8fff0;
    border-width: 1px;
    border-color: #93e6ad;

    color: #079447;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.attempt-body {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 14px;
}

.attempt-row {
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.attempt-row-label {
    color: #98a6bb;
    font-size: 12px;
}

.attempt-row-value {
    flex-grow: 1;
    margin-left: 16px;
    color: #172033;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.attempt-score {
    color: #0a9f45;
}

.attempt-row-divider {
    height: 1px;
    background-color: #edf1f5;
}

.review-attempt-button {
    width: 100%;
    height: 46px;
    margin-top: 10px;

    border-width: 2px;
    border-color: #0f53bd;
    border-radius: 23px;

    background-color: #f8fbff;
    color: #0f53bd;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.review-attempt-button:hover {
    background-color: #eef5ff;
}

/* =========================
   NOTICE
   ========================= */

.notice-card {
    width: 100%;

    margin-top: 18px;

    padding-top: 17px;
    padding-bottom: 17px;
    padding-left: 16px;
    padding-right: 17px;

    flex-direction: row;

    background-color: #fffaf0;

    border-width: 1px;
    border-color: #f5c74f;
    border-radius: 17px;
}

.notice-icon {
    width: 17px;
    height: 17px;

    margin-top: 1px;
    margin-right: 10px;

    border-width: 1px;
    border-color: #e88a17;
    border-radius: 9px;

    color: #e88a17;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notice-content {
    flex-grow: 1;
    flex-shrink: 1;
}

.notice-title {
    font-size: 12px;
    color: #9a4f0c;
    -unity-font-style: bold;
}

.notice-description {
    margin-top: 4px;

    font-size: 12px;
    color: #a65c21;

    white-space: normal;
}

/* =========================
   BOTTOM BUTTON
   ========================= */

.bottom-area {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    min-height: 100px;

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 16px;
    padding-bottom: 18px;

    background-color: #ffffff;

    align-items: center;
    justify-content: center;
}

.bottom-shadow {
    position: absolute;

    left: 0;
    right: 0;
    top: -14px;

    height: 14px;

    background-color: rgba(16, 24, 40, 0.04);
}

.start-quiz-button {
    width: 100%;
    max-width: 450px;
    height: 58px;

    border-width: 0;
    border-radius: 17px;

    background-color: #1155c6;

    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.start-quiz-button:hover {
    background-color: #0d4db8;
}

.start-quiz-button:active {
    background-color: #0b429d;
}

.start-quiz-button:disabled {
    background-color: #b7c4d6;
    color: #eef2f7;
}

/* =========================
   CONFIRMATION POPUP
   ========================= */

.confirmation-overlay {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    padding-left: 24px;
    padding-right: 24px;

    background-color: rgba(15, 23, 42, 0.55);

    align-items: center;
    justify-content: center;
}

.confirmation-dialog {
    width: 100%;
    max-width: 390px;

    padding-top: 26px;
    padding-bottom: 22px;
    padding-left: 22px;
    padding-right: 22px;

    background-color: #ffffff;

    border-radius: 20px;
}

.confirmation-title {
    font-size: 20px;
    color: #111827;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.confirmation-message {
    margin-top: 10px;

    font-size: 13px;
    color: #64748b;

    white-space: normal;
    -unity-text-align: middle-center;
}

.confirmation-actions {
    margin-top: 24px;

    flex-direction: row;
}

.dialog-button {
    flex-grow: 1;
    height: 48px;

    border-radius: 13px;

    font-size: 13px;
    -unity-font-style: bold;
}

.cancel-dialog-button {
    margin-right: 7px;

    background-color: #f1f5f9;
    color: #475569;

    border-width: 0;
}

.confirm-dialog-button {
    margin-left: 7px;

    background-color: #1155c6;
    color: #ffffff;

    border-width: 0;
}

.hidden {
    display: none;
}

/* =========================
   SMALL SCREEN
   ========================= */

@media (max-width: 390px) {
    .header {
        padding-left: 12px;
        padding-right: 12px;
    }

    .status-badge {
        min-width: 98px;
        padding-left: 8px;
        padding-right: 8px;
    }

    .status-label {
        font-size: 8px;
    }

    .quiz-card-header {
        padding-left: 18px;
        padding-right: 18px;
    }

    .info-row {
        padding-left: 18px;
        padding-right: 18px;
    }

    .row-divider {
        margin-left: 18px;
        margin-right: 18px;
    }

    .info-value {
        font-size: 11px;
    }
}

/* Hide the lesson page scrollbars while keeping touch/mouse-wheel scrolling enabled. */
.quiz-scroll-view > .unity-scroller--vertical,
.quiz-scroll-view .unity-scroller--vertical,
.quiz-scroll-view > .unity-scroller--horizontal,
.quiz-scroll-view .unity-scroller--horizontal {
    display: none;
}

/* =========================
   TEACHER VIEW: QUESTIONS & ANSWER KEY (2026-10)
   ========================= */

.tq-section {
    width: 100%;
    margin-top: 22px;
}

.tq-heading {
    flex-direction: row;
    align-items: center;
}

.tq-heading-title {
    font-size: 11px;
    letter-spacing: 1px;
    color: #64748b;
    -unity-font-style: bold;
}

.tq-heading-line {
    flex-grow: 1;
    height: 1px;
    margin-left: 10px;
    background-color: #e2e8f0;
}

.tq-hint {
    margin-top: 6px;
    font-size: 11px;
    color: #94a3b8;
    white-space: normal;
}

.tq-message {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: #eafff1;
    border-width: 1px;
    border-color: #8ee5aa;
    color: #087c3b;
    font-size: 12px;
    white-space: normal;
}

.tq-message-error {
    background-color: #fff1f2;
    border-color: #fda4af;
    color: #be123c;
}

.tq-list {
    margin-top: 12px;
}

.tq-info {
    padding: 18px;
    color: #64748b;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.tq-card {
    margin-bottom: 14px;
    padding: 16px;
    border-radius: 16px;
    border-width: 1px;
    border-color: #e6ebf2;
    background-color: #ffffff;
}

.tq-card-editing {
    border-color: #93b4f0;
    border-width: 1.5px;
}

.tq-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.tq-card-header-left {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 1;
}

.tq-number {
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 6px;
    border-radius: 13px;
    background-color: #0f53bd;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tq-chip {
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 6px;
    border-radius: 11px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tq-chip-mcq {
    background-color: #eef4ff;
    color: #1d4ed8;
}

.tq-chip-essay {
    background-color: #fff7e6;
    color: #b45309;
}

.tq-chip-edited {
    background-color: #eafff1;
    color: #087c3b;
}

.tq-chip-ai {
    background-color: #f3e8ff;
    color: #7e22ce;
}

.tq-edit-button {
    height: 30px;
    min-width: 64px;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 15px;
    border-width: 1px;
    border-color: #c7d7f5;
    background-color: #f2f6ff;
    color: #1155c6;
    font-size: 12px;
    -unity-font-style: bold;
}

.tq-question-text {
    margin-bottom: 10px;
    font-size: 14px;
    color: #101828;
    -unity-font-style: bold;
    white-space: normal;
}

.tq-option {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    margin-top: 6px;
    padding: 8px 10px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e6ebf2;
    background-color: #f8faff;
}

.tq-option-correct {
    border-color: #4ade80;
    background-color: #ecfdf3;
}

.tq-option-key {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    border-radius: 13px;
    background-color: #e2e8f0;
    color: #334155;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.tq-option-correct .tq-option-key {
    background-color: #16a34a;
    color: #ffffff;
}

.tq-option-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    color: #1f2937;
    white-space: normal;
}

.tq-correct-tag {
    margin-left: 8px;
    padding-left: 8px;
    padding-right: 8px;
    height: 22px;
    border-radius: 11px;
    background-color: #16a34a;
    color: #ffffff;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.tq-block {
    margin-top: 8px;
    padding: 10px 12px;
    border-radius: 12px;
}

.tq-block-answer {
    background-color: #ecfdf3;
    border-width: 1px;
    border-color: #86efac;
}

.tq-block-points {
    background-color: #f8faff;
    border-width: 1px;
    border-color: #e2e8f0;
}

.tq-block-title {
    font-size: 11px;
    color: #087c3b;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tq-block-points .tq-block-title {
    color: #475569;
}

.tq-block-body {
    font-size: 12px;
    color: #1f2937;
    white-space: normal;
}

.tq-field-label {
    margin-top: 10px;
    margin-bottom: 4px;
    font-size: 11px;
    color: #64748b;
    -unity-font-style: bold;
    white-space: normal;
}

.tq-input {
    margin: 0;
    flex-shrink: 1;
}

.tq-input > .unity-text-field__input,
.tq-input .unity-base-text-field__input {
    min-height: 40px;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #d5deea;
    background-color: #ffffff;
    color: #101828;
    font-size: 13px;
    white-space: normal;
}

.tq-input .unity-text-element {
    white-space: normal;
}

.tq-input:focus > .unity-text-field__input,
.tq-input:focus .unity-base-text-field__input {
    border-color: #1155c6;
}

.tq-edit-option {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 6px;
}

.tq-key-button {
    width: 36px;
    height: 36px;
    margin: 2px 8px 0 0;
    padding: 0;
    border-radius: 18px;
    border-width: 1px;
    border-color: #cbd5e1;
    background-color: #f1f5f9;
    color: #334155;
    font-size: 13px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.tq-key-button-correct {
    background-color: #16a34a;
    border-color: #16a34a;
    color: #ffffff;
}

.tq-option-field {
    flex-grow: 1;
}

.tq-option-field-correct > .unity-text-field__input,
.tq-option-field-correct .unity-base-text-field__input {
    border-color: #4ade80;
    background-color: #f0fdf4;
}

.tq-add-option {
    align-self: flex-start;
    margin: 8px 0 0 44px;
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 15px;
    border-width: 1px;
    border-color: #c7d7f5;
    background-color: #ffffff;
    color: #1155c6;
    font-size: 12px;
}

.tq-card-error {
    margin-top: 10px;
    color: #be123c;
    font-size: 12px;
    white-space: normal;
}

.tq-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 14px;
}

.tq-cancel-button,
.tq-save-button {
    height: 38px;
    min-width: 90px;
    margin: 0 0 0 8px;
    border-radius: 19px;
    font-size: 13px;
    -unity-font-style: bold;
}

.tq-cancel-button {
    border-width: 1px;
    border-color: #d5deea;
    background-color: #ffffff;
    color: #475569;
}

.tq-save-button {
    border-width: 0;
    background-color: #1155c6;
    color: #ffffff;
}
