<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="ChatAIPage.uss"/>

    <ui:VisualElement name="chat-root" class="chat-root">
        <!-- White continuation behind the Android top safe area. This element is
             absolutely positioned, so it never moves the header text or buttons. -->
        <ui:VisualElement name="chat-top-safe-background" class="chat-top-safe-background" picking-mode="Ignore"/>
        <ui:VisualElement name="safe-area" class="safe-area">
            <ui:VisualElement name="chat-header" class="chat-header unified-header-spacing">
                <ui:Button name="back-button" class="round-icon-button">
                    <ui:VisualElement class="button-icon back-icon"/>
                </ui:Button>

                <ui:VisualElement class="teacher-avatar-wrapper">
                    <ui:VisualElement class="teacher-avatar">
                        <ui:Label name="partner-avatar-text" text="" class="teacher-avatar-text ai-avatar-icon" picking-mode="Ignore"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="header-online-dot" class="online-dot offline"/>
                </ui:VisualElement>

                <ui:VisualElement class="teacher-information">
                    <ui:Label name="teacher-name" text="AI Assistant" class="teacher-name"/>
                    <ui:VisualElement class="teacher-status-row">
                        <ui:VisualElement class="presence-status-group">
                            <ui:VisualElement name="status-dot" class="status-dot offline"/>
                            <ui:Label name="teacher-status" text="Ready to help" class="teacher-status"/>
                        </ui:VisualElement>
                        <ui:Label text="•" class="status-divider"/>
                        <ui:Label name="teacher-position" text="AI Assistant" class="teacher-position"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="header-actions">
                    <ui:Button name="more-button" class="round-icon-button">
                        <ui:VisualElement class="button-icon menu-icon"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="course-banner">
                <ui:VisualElement class="course-icon"/>
                <ui:Label name="course-label" text="AI learning assistant" class="course-label"/>
            </ui:VisualElement>

            <ui:ScrollView name="message-scroll-view" class="message-scroll-view" mode="Vertical"
                           horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement name="message-container" class="message-container">
                    <ui:VisualElement name="date-separator" class="date-separator">
                        <ui:VisualElement class="separator-line"/>
                        <ui:Label name="date-label" text="Today" class="date-label"/>
                        <ui:VisualElement class="separator-line"/>
                    </ui:VisualElement>

                    <ui:VisualElement name="empty-chat" class="empty-chat">
                        <ui:Label name="empty-chat-title" text="Start a conversation with AI" class="empty-chat-title ai-empty-chat-title"/>
                        <ui:Label name="empty-chat-description" text="Your AI chat history is private to this signed-in user on this device." class="empty-chat-description"/>
                    </ui:VisualElement>

                    <ui:VisualElement name="typing-row" class="typing-row">
                        <ui:VisualElement class="teacher-small-avatar">
                            <ui:Label name="typing-avatar-text" text="" class="teacher-small-avatar-text ai-avatar-icon ai-avatar-icon-small" picking-mode="Ignore"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="typing-content">
                            <ui:VisualElement class="typing-bubble">
                                <ui:VisualElement class="typing-dot"/>
                                <ui:VisualElement class="typing-dot"/>
                                <ui:VisualElement class="typing-dot"/>
                            </ui:VisualElement>
                            <ui:Label name="typing-label" text="Typing..." class="typing-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement name="composer-section" class="composer-section">
                <ui:VisualElement name="message-input-section" class="message-input-section">
                    <ui:Button name="attachment-button" class="input-side-button">
                        <ui:VisualElement class="attachment-icon"/>
                    </ui:Button>
                    <ui:VisualElement class="message-input-wrapper">
                        <ui:TextField name="message-input" class="message-input" multiline="False"/>
                        <ui:Label name="input-placeholder" text="Ask AI Assistant..." class="input-placeholder" picking-mode="Ignore"/>
                    </ui:VisualElement>
                    <ui:Button name="send-button" class="send-button">
                        <ui:VisualElement name="send-icon" class="send-icon"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Keep the photo tray below the composer. When it opens it takes
                 space from the message list and moves the composer upward,
                 matching the Android keyboard behaviour. -->
            <ui:VisualElement name="image-gallery-panel" class="image-gallery-panel">
                <ui:VisualElement class="image-gallery-header">
                    <ui:Label name="image-gallery-title" text="Recent photos" class="image-gallery-title"/>
                    <ui:Button name="close-image-gallery-button" text="×" class="close-image-gallery-button"/>
                </ui:VisualElement>
                <ui:Label name="image-gallery-status" text="Loading photos..." class="image-gallery-status"/>
                <ui:ScrollView name="image-gallery-scroll" class="image-gallery-scroll" mode="Vertical"
                               horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    <ui:VisualElement name="image-gallery-grid" class="image-gallery-grid"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
