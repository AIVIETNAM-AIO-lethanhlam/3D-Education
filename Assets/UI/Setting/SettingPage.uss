/* =========================================================
   PAGE
   ========================================================= */

.setting-page {
    width: 100%;
    height: 100%;

    flex-direction: column;

    background-color: rgb(247, 249, 253);
    color: rgb(4, 30, 76);

    -unity-font-definition:
        resource("Fonts/Inter_24pt-Regular");
}


/* =========================================================
   SCROLL VIEW
   ========================================================= */

.setting-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;

    background-color: rgb(247, 249, 253);
}

.setting-scroll-view .unity-scroll-view__content-container {
    flex-direction: column;
}

.setting-scroll-view .unity-scroller--vertical,
.setting-scroll-view .unity-scroller--horizontal {
    display: none;
}

.setting-content {
    width: 100%;

    padding-top: 18px;
    padding-right: 22px;
    padding-left: 22px;
}


/* =========================================================
   COMMON CARD
   ========================================================= */

.setting-card {
    width: 100%;

    margin-bottom: 18px;

    border-width: 1px;
    border-color: rgb(213, 223, 240);
    border-radius: 18px;

    background-color: rgb(255, 255, 255);
}

.section-card {
    overflow: hidden;
}

.section-title {
    height: 55px;

    padding-left: 20px;

    font-size: 15px;
    color: rgb(88, 106, 145);

    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.section-divider {
    width: 100%;
    height: 1px;

    flex-shrink: 0;

    background-color: rgb(218, 226, 240);
}


/* =========================================================
   PROFILE
   ========================================================= */

.profile-card {
    min-height: 116px;

    padding-top: 19px;
    padding-right: 16px;
    padding-bottom: 19px;
    padding-left: 18px;

    flex-direction: row;
    align-items: center;
}

.profile-avatar {
    width: 68px;
    height: 68px;

    margin-right: 17px;

    flex-grow: 0;
    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 18px;

    background-color: rgb(0, 70, 180);
}

.profile-avatar-icon {
    width: 32px;
    height: 32px;

    background-image:
        url("project://database/Assets/UI/Images/Icons/profile-white.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
}

.profile-info {
    min-width: 0;

    flex-grow: 1;
    flex-shrink: 1;
}

.profile-name {
    margin-bottom: 3px;

    font-size: 19px;
    color: rgb(0, 23, 64);

    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.profile-email {
    margin-bottom: 6px;

    font-size: 13px;
    color: rgb(89, 108, 149);

    -unity-text-align: middle-left;
}

.profile-badge-row {
    flex-direction: row;
    align-items: center;
}

.profile-badge {
    height: 22px;
    min-width: 60px;

    margin-right: 7px;
    padding-left: 9px;
    padding-right: 9px;

    border-radius: 11px;

    font-size: 11px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.role-badge {
    color: rgb(0, 66, 178);
    background-color: rgb(232, 240, 255);
}

.active-badge {
    color: rgb(0, 162, 67);
    background-color: rgb(226, 249, 235);
}

.profile-edit-button {
    width: 38px;
    height: 38px;

    margin-left: 6px;
    padding: 8px;

    flex-shrink: 0;
    align-items: center;
    justify-content: center;

    border-width: 0;

    background-color: rgba(0, 0, 0, 0);
}

.profile-edit-icon {
    width: 20px;
    height: 20px;

    background-image:
        url("project://database/Assets/UI/Images/Icons/edit.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(78, 101, 145);
}


/* =========================================================
   COMMON ROW
   ========================================================= */

.setting-row {
    width: 100%;
    min-height: 72px;

    padding-right: 20px;
    padding-left: 20px;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    border-width: 0;
    border-radius: 0;

    background-color: rgba(0, 0, 0, 0);
}

.setting-row:hover {
    background-color: rgb(248, 250, 254);
}

.row-icon {
    width: 21px;
    height: 21px;

    margin-right: 15px;

    flex-grow: 0;
    flex-shrink: 0;

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(3, 72, 184);
}

.row-text-container {
    min-width: 0;

    flex-grow: 1;
    flex-shrink: 1;

    align-items: flex-start;
    justify-content: center;
}

.row-title {
    margin: 0;
    padding: 0;

    font-size: 16px;
    color: rgb(1, 27, 73);

    -unity-text-align: middle-left;
}

.row-description {
    margin-top: 2px;

    font-size: 13px;
    color: rgb(86, 105, 146);

    -unity-text-align: middle-left;
}

.row-grow {
    flex-grow: 1;
    flex-shrink: 1;

    -unity-text-align: middle-left;
}

#user-information-button .row-text-container,
#user-information-button .row-title,
#user-information-button .row-description {
    -unity-text-align: middle-left;
}

.chevron-icon {
    width: 14px;
    height: 14px;

    flex-shrink: 0;

    background-image:
        url("project://database/Assets/UI/Images/Icons/chevron-right.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(91, 109, 146);
}


/* =========================================================
   ICONS
   ========================================================= */

.user-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/profile.png");
}

.sun-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/sun.png");
}

.language-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/globe.png");
}

.volume-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/volume.png");
}

.headphone-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/headphone.png");
}

.tutorial-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/lightbulb.png");
}

.privacy-icon {
    background-image:
        url("project://database/Assets/UI/Images/Icons/document.png");
}


/* =========================================================
   LANGUAGE
   ========================================================= */

.language-switch {
    padding: 3px;

    flex-direction: row;
    flex-shrink: 0;

    border-radius: 17px;

    background-color: rgb(235, 241, 253);
}

.language-button {
    width: 41px;
    height: 29px;

    padding: 0;

    border-width: 0;
    border-radius: 14px;

    font-size: 13px;
    color: rgb(89, 107, 145);

    -unity-font-style: bold;

    background-color: rgba(0, 0, 0, 0);
}

.language-button-active {
    color: rgb(255, 255, 255);
    background-color: rgb(3, 68, 179);
}


/* =========================================================
   TOGGLE
   ========================================================= */

.switch-toggle {
    width: 52px;
    height: 30px;

    margin: 0;
    padding: 0;

    flex-grow: 0;
    flex-shrink: 0;
}

.switch-toggle .unity-toggle__label {
    display: none;
}

.switch-toggle .unity-toggle__input {
    width: 52px;
    height: 30px;

    margin: 0;
    padding: 0;

    border-width: 0;
    border-radius: 15px;

    background-color: rgb(231, 237, 250);
}

.switch-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;

    margin-left: 5px;

    border-width: 0;
    border-radius: 10px;

    background-image: none;
    background-color: rgb(255, 255, 255);
}

.switch-toggle:checked .unity-toggle__input {
    background-color: rgb(0, 67, 179);
}

.switch-toggle:checked .unity-toggle__checkmark {
    margin-left: 27px;

    background-image: none;
    background-color: rgb(255, 255, 255);
}


/* =========================================================
   AUDIO
   ========================================================= */

.audio-row {
    width: 100%;
    min-height: 78px;

    padding-right: 20px;
    padding-left: 20px;

    flex-direction: row;
    align-items: center;
}

.audio-content {
    min-width: 0;

    flex-grow: 1;
    flex-shrink: 1;
}

.audio-header {
    margin-bottom: 6px;

    flex-direction: row;
    align-items: center;
}

.volume-value {
    font-size: 13px;
    color: rgb(0, 66, 179);
}

.volume-slider-container {
    position: relative;

    width: 100%;
    height: 18px;
}

.volume-slider-background {
    position: absolute;

    left: 0;
    right: 0;
    top: 5px;

    height: 8px;

    border-radius: 4px;

    background-color: rgb(228, 235, 249);
}

.volume-slider-fill {
    position: absolute;

    left: 0;
    top: 5px;

    width: 0%;
    height: 8px;

    border-radius: 4px;

    background-color: rgb(0, 67, 179);
}

.volume-slider {
    position: absolute;

    left: 0;
    right: 0;
    top: 5px;

    width: 100%;
    height: 18px;

    margin: 0;
    padding: 0;

    background-color: rgba(0, 0, 0, 0);
}

.volume-slider .unity-base-slider__label {
    display: none;
}

.volume-slider .unity-base-slider__input,
.volume-slider .unity-base-slider__tracker {
    height: 18px;

    margin: 0;
    padding: 0;

    border-width: 0;

    background-color: rgba(0, 0, 0, 0);
}

.volume-slider .unity-base-slider__dragger-border {
    display: none;
}

.volume-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;

    border-width: 0;
    border-radius: 7px;

    background-color: rgb(0, 67, 179);
}


/* =========================================================
   RECOVERY
   ========================================================= */

.recovery-card {
    width: 100%;

    margin-bottom: 18px;

    padding-top: 17px;
    padding-right: 18px;
    padding-bottom: 17px;
    padding-left: 18px;

    border-width: 1px;
    border-color: rgb(255, 184, 65);
    border-radius: 18px;

    background-color: rgb(255, 248, 234);
}

.recovery-top-row {
    width: 100%;

    margin-bottom: 6px;

    flex-direction: row;
    align-items: flex-start;
}

.warning-icon {
    width: 22px;
    height: 22px;

    margin-right: 13px;

    flex-shrink: 0;

    background-image:
        url("project://database/Assets/UI/Images/Icons/warning.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
}

.recovery-text-container {
    min-width: 0;

    flex-grow: 1;
    flex-shrink: 1;
}

.recovery-title {
    margin-bottom: 4px;

    font-size: 16px;
    color: rgb(2, 28, 73);

    -unity-font-style: bold;
}

.recovery-description {
    white-space: normal;

    font-size: 13px;
    color: rgb(89, 105, 143);
}

.recovery-button-row {
    width: 100%;

    margin-top: 0;
    padding-left: 35px;

    flex-direction: row;
}

.recovery-button {
    height: 40px;

    flex-grow: 1;

    padding: 0;

    border-width: 0;
    border-radius: 20px;

    font-size: 14px;

    -unity-font-style: bold;
}

.restore-button {
    margin-right: 9px;

    color: rgb(255, 255, 255);
    background-color: rgb(255, 153, 0);
}

.dismiss-button {
    color: rgb(3, 30, 76);
    background-color: rgb(235, 241, 253);
}


/* =========================================================
   PRIVACY
   ========================================================= */

.privacy-card {
    min-height: 62px;

    padding-left: 18px;
    padding-right: 18px;

    flex-direction: row;
    align-items: center;
}


/* =========================================================
   LOGOUT
   ========================================================= */

.logout-button {
    min-height: 62px;

    padding: 0;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    border-color: rgb(255, 184, 184);

    background-color: rgb(255, 255, 255);
}

.logout-button-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.logout-icon {
    width: 19px;
    height: 19px;

    margin-right: 9px;

    background-image:
        url("project://database/Assets/UI/Images/Icons/logout.png");

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(239, 70, 70);
}

.logout-label {
    font-size: 15px;
    color: rgb(239, 70, 70);

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.logout-button:hover {
    background-color: rgb(255, 247, 247);
}

.logout-button:active {
    background-color: rgb(255, 238, 238);
}

.content-bottom-space {
    height: 14px;
    flex-shrink: 0;
}
