.page-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(247, 249, 253);
    color: rgb(14, 35, 73);
}

/* Do not place a custom font URL here. The previous MissingAssetReference
   caused all text to disappear in the Game view. */

.class-header {
    width: 100%;
    flex-shrink: 0;
    padding-top: 24px; 
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 17px;
    background-color: rgb(25, 91, 207);
}

.safe-top-space { height: 24px; }

.header-navigation {
    min-height: 50px;
    height: auto;
    flex-direction: row;
    align-items: flex-start;
}

.round-header-button {
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    flex-shrink: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.20);
    border-radius: 19px;
    background-color: rgba(255, 255, 255, 0.10);
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.back-button {
    margin-top: 6px;
    padding: 0;
    font-size: 25px;
    -unity-text-align: middle-center;
}

.more-button {
    margin-top: 6px;
    padding: 0;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.class-title-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 12px;
    margin-right: 10px;
    padding-bottom: 3px;
    justify-content: flex-start;
    overflow: hidden;
}

.semester-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.78);
    -unity-font-style: bold;
}

.class-title-label {
    width: 100%;
    min-width: 0;
    margin-top: 2px;
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    white-space: normal;
    overflow: hidden;
}

.teacher-card {
    height: 68px;
    margin-top: 7px;
    padding-left: 14px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 15px;
    background-color: rgba(255, 255, 255, 0.12);
}

.teacher-avatar {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background-color: rgb(255, 171, 35);
}

.teacher-initial-label {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.teacher-information {
    flex-grow: 1;
    min-width: 0;
    margin-left: 11px;
    justify-content: center;
}

.teacher-name-label {
    margin-bottom: -1px;
    font-size: 14px;
    color: white;
    -unity-font-style: bold;
}

.teacher-position-label {
    margin-top: -2px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.78);
}

.teacher-message-button {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.12);
}

.teacher-message-icon {
    width: 17px;
    height: 17px;
    background-image: url("project://database/Assets/UI/Images/Icons/message-white.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.teacher-message-unread-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 17px;
    height: 17px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 9px;
    background-color: #FF3B30;
    color: white;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.teacher-message-unread-badge.hidden {
    display: none;
}

.statistics-row {
    height: 31px;
    margin-top: 8px;
    flex-direction: row;
    align-items: flex-end;
}

.statistic-item {
    margin-right: 20px;
    flex-direction: row;
    align-items: center;
}

.statistic-last { margin-right: 0; }

.statistic-value {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

.statistic-name {
    margin-left: 2px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 10px;
}

.tab-navigation {
    height: 53px;
    flex-shrink: 0;
    flex-direction: row;

    /* Gom 3 tab lại gần nhau và canh cả nhóm vào giữa. */
    justify-content: center;
    align-items: stretch;

    background-color: white;
    border-bottom-width: 1px;
    border-bottom-color: rgb(229, 234, 243);
}

.tab-button {
    position: relative;
    width: 100px;
    min-width: 100px;
    max-width: 100px;
    height: 53px;

    /* Không kéo giãn mỗi tab ra 1/3 toàn màn hình nữa. */
    flex-grow: 0;
    flex-shrink: 0;

    padding: 0;
    border-width: 0;
    border-radius: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    background-color: white;
    color: rgb(85, 104, 142);
    font-size: 11px;
    -unity-font-style: bold;
}


/* Red notification dot on the Student List tab.
   It disappears when the teacher opens Student List and appears again only
   when a NEW unread student message arrives afterwards. */
.student-list-unread-dot {
    position: absolute;

    /*
     * Student List tab rộng cố định 96px.
     * Đặt dot sát bên phải chữ "Student List", thay vì ở mép xa của tab.
     */
    right: 4px;
    top: 14px;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(235, 66, 66);
}

.tab-button-active {
    color: rgb(24, 87, 203);
    border-bottom-color: rgb(24, 87, 203);
}

.content-scroll-view {
    flex-grow: 1;
    background-color: rgb(247, 249, 253);
}

.content-scroll-view .unity-scroll-view__vertical-scroller,
.content-scroll-view .unity-scroller--vertical {
    display: none;
    width: 0;
}

.syllabus-content {
    padding-left: 19px;
    padding-right: 19px;
    padding-top: 17px;
    padding-bottom: 38px;
}

.progress-card {
    height: 76px;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 12px;
    padding-bottom: 11px;
    border-width: 1px;
    border-color: rgb(225, 231, 241);
    border-radius: 15px;
    background-color: white;
}

.progress-heading-row,
.progress-bottom-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.progress-title {
    color: rgb(93, 110, 145);
    font-size: 10px;
    -unity-font-style: bold;
}

.progress-percent {
    color: rgb(21, 83, 196);
    font-size: 20px;
    -unity-font-style: bold;
}

.progress-bottom-row { margin-top: 5px; }

.progress-track {
    height: 7px;
    flex-grow: 1;
    margin-right: 13px;
    overflow: hidden;
    border-radius: 4px;
    background-color: rgb(232, 237, 247);
}

.progress-fill {
    width: 52%;
    height: 100%;
    border-radius: 4px;
    background-color: rgb(25, 92, 213);
}

.progress-detail {
    color: rgb(114, 129, 158);
    font-size: 9px;
}

.reorder-preview {
    height: 42px;
    margin-top: 12px;
    padding-left: 14px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgb(222, 228, 239);
    border-radius: 21px;
    background-color: rgb(249, 251, 254);
}

.reorder-preview-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Images/Icons/drag.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(169, 181, 203);
}

.reorder-preview-text {
    margin-left: 5px;
    color: rgb(145, 160, 186);
    font-size: 10px;
    -unity-font-style: bold;
}

.chapter-list { margin-top: 12px; }

.chapter-card {
    margin-bottom: 12px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgb(223, 229, 239);
    border-radius: 15px;
    background-color: white;
}

.chapter-header-row {
    min-height: 82px;
    padding-left: 11px;
    padding-right: 9px;
    flex-direction: row;
    align-items: center;
}

.drag-handle,
.lesson-drag-handle {
    width: 16px;
    margin-right: 6px;
    color: rgb(182, 195, 215);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.chapter-status-circle {
    width: 39px;
    height: 39px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-radius: 20px;
    background-color: white;
}

.chapter-status-complete { border-color: rgb(27, 196, 106); }
.chapter-status-upcoming { border-color: rgb(225, 232, 244); }
.chapter-status-in-progress { border-color: rgb(57, 111, 215); }

.chapter-status-symbol {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chapter-status-complete .chapter-status-symbol { color: rgb(27, 196, 106); }
.chapter-status-upcoming .chapter-status-symbol { color: rgb(144, 160, 188); }
.chapter-status-in-progress .chapter-status-symbol { color: rgb(57, 111, 215); }


.chapter-status-icon {
    width: 18px;
    height: 18px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.chapter-check-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/check.png");
}

.chapter-upcoming-icon {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/UI/Images/Icons/lock.png");
}

.chapter-progress-percent {
    color: rgb(38, 96, 203);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.delete-icon {
    width: 14px;
    height: 14px;
    background-image: url("project://database/Assets/UI/Images/Icons/delete.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.collapse-arrow-icon {
    width: 13px;
    height: 13px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.arrow-up-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/arrow-up.png");
}

.arrow-down-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/arrow-down.png");
}

.lesson-status-icon {
    width: 15px;
    height: 15px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.lesson-check-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/check.png");
}

.lesson-book-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/book.png");
}

.chapter-information {
    flex-grow: 1;
    margin-left: 9px;
    margin-right: 4px;
    justify-content: center;
}

.chapter-index-label {
    color: rgb(96, 115, 151);
    font-size: 8px;
    -unity-font-style: bold;
}

.chapter-title-label {
    margin-top: 2px;
    color: rgb(12, 31, 68);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.chapter-meta-row {
    margin-top: 3px;
    flex-direction: row;
    align-items: center;
}

.chapter-lesson-count,
.chapter-meta-separator,
.chapter-status-label {
    font-size: 8px;
}

.chapter-lesson-count { color: rgb(125, 140, 166); }
.chapter-meta-separator { margin-left: 4px; margin-right: 4px; color: rgb(166, 176, 196); }
.chapter-status-label { -unity-font-style: bold; }
.status-text-complete { color: rgb(18, 177, 88); }
.status-text-in-progress { color: rgb(49, 101, 207); }
.status-text-upcoming { color: rgb(98, 116, 151); }

.chapter-action-button {
    width: 29px;
    height: 29px;
    min-width: 29px;
    min-height: 29px;
    margin-left: 5px;
    padding: 0;
    border-width: 0;
    border-radius: 15px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.delete-chapter-button {
    background-color: rgb(255, 239, 239);
    align-items: center;
    justify-content: center;
}

.collapse-chapter-button {
    background-color: rgb(239, 244, 255);
    align-items: center;
    justify-content: center;
}

.lesson-list {
    border-top-width: 1px;
    border-top-color: rgb(229, 233, 241);
}

.lesson-row {
    min-height: 58px;
    padding-left: 11px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(229, 233, 241);
    background-color: white;
}

.lesson-status-circle {
    width: 31px;
    height: 31px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background-color: rgb(237, 245, 255);
}

.lesson-complete-circle { background-color: rgb(226, 248, 236); }
.lesson-status-symbol {
    color: rgb(27, 190, 102);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.lesson-default-symbol { color: rgb(38, 96, 203); }

.lesson-information {
    flex-grow: 1;
    margin-left: 9px;
    justify-content: center;
}

.lesson-title {
    color: rgb(15, 34, 72);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.lesson-badge {
    margin-top: 2px;
    align-self: flex-start;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 6px;
    background-color: rgb(232, 240, 255);
    color: rgb(27, 92, 207);
    font-size: 8px;
    -unity-font-style: bold;
}

.add-lesson-button {
    height: 43px;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 0;
    background-color: white;
    color: rgb(19, 80, 190);
    font-size: 10px;
    -unity-font-style: bold;
}

.add-lesson-plus { margin-right: 6px; color: rgb(19, 80, 190); font-size: 15px; }

.add-chapter-card {
    min-height: 126px;
    padding-top: 16px;
    padding-bottom: 16px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(177, 202, 245);
    border-radius: 15px;
    background-color: rgb(248, 251, 255);
}

.add-chapter-icon-circle {
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background-color: rgb(230, 238, 253);
}

.add-chapter-plus { color: rgb(29, 91, 207); font-size: 21px; -unity-text-align: middle-center; }
.add-chapter-title { margin-top: 8px; color: rgb(17, 66, 153); font-size: 12px; -unity-font-style: bold; }
.add-chapter-description { margin-top: 5px; color: rgb(103, 120, 153); font-size: 9px; }

.empty-tab-content {
    min-height: 420px;
    padding: 30px;
    align-items: center;
    justify-content: center;
}
.empty-state-title { color: rgb(15, 34, 72); font-size: 17px; -unity-font-style: bold; }
.empty-state-description { margin-top: 7px; color: rgb(112, 128, 158); font-size: 11px; white-space: normal; -unity-text-align: middle-center; }
.hidden { display: none; }


.drag-icon,
.lesson-drag-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    margin-right: 7px;
    background-image: url("project://database/Assets/UI/Images/Icons/drag.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(182, 195, 215);
}


/* ================= EDIT MODE ================= */
.edit-content-button {
    width: 100%;
    height: 46px;
    margin-top: 12px;
    margin-bottom: 4px;
    border-width: 0;
    border-radius: 13px;
    background-color: rgb(30, 96, 216);
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

.chapter-edit-actions,
.lesson-edit-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 6px;
}

.inline-edit-button,
.inline-delete-button {
    width: 31px;
    min-width: 31px;
    height: 31px;
    min-height: 31px;
    margin-left: 4px;
    padding: 0;
    border-width: 0;
    border-radius: 15px;
    align-items: center;
    justify-content: center;
}

.inline-edit-button {
    background-color: rgb(235, 243, 255);
}

.inline-delete-button {
    background-color: rgb(255, 237, 239);
}

.inline-edit-icon,
.inline-delete-icon {
    width: 15px;
    height: 15px;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.inline-edit-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/edit.png");
    -unity-background-image-tint-color: rgb(28, 95, 216);
}

.inline-delete-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/delete.png");
    -unity-background-image-tint-color: rgb(235, 55, 70);
}

.chapter-information,
.lesson-information {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.chapter-title-label,
.lesson-title {
    white-space: normal;
}

.editor-modal-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgba(0, 0, 0, 0.48);
}

.editor-modal-card {
    width: 100%;
    max-width: 430px;
    padding: 22px;
    border-radius: 18px;
    background-color: white;
}

.editor-modal-title {
    font-size: 18px;
    color: rgb(16, 37, 77);
    -unity-font-style: bold;
}

.editor-modal-message {
    margin-top: 9px;
    font-size: 13px;
    color: rgb(81, 98, 132);
    white-space: normal;
}

.editor-modal-input {
    margin-top: 14px;
    height: 44px;
}

.editor-modal-input .unity-text-input {
    padding-left: 11px;
    padding-right: 11px;
    border-width: 1px;
    border-color: rgb(190, 205, 231);
    border-radius: 10px;
    background-color: rgb(249, 251, 255);
}

.editor-modal-actions {
    margin-top: 18px;
    flex-direction: row;
}

.editor-modal-button {
    flex-grow: 1;
    height: 42px;
    border-width: 0;
    border-radius: 11px;
    -unity-font-style: bold;
}

.editor-modal-cancel {
    margin-right: 8px;
    background-color: rgb(237, 241, 248);
    color: rgb(45, 63, 98);
}

.editor-modal-confirm {
    margin-left: 8px;
    background-color: rgb(30, 96, 216);
    color: white;
}

/* ================= 3D LABS ================= */

.labs-content {
    width: 100%;
    padding-left: 19px;
    padding-right: 19px;
    padding-top: 16px;
    padding-bottom: 38px;
}

.labs-description {
    width: 100%;
    margin-bottom: 12px;
    color: rgb(91, 108, 142);
    font-size: 11px;
    white-space: normal;
}

.model-card-list {
    width: 100%;
}

.model-card {
    width: 100%;
    min-height: 88px;
    margin-bottom: 12px;
    padding-left: 13px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgb(222, 229, 241);
    border-radius: 15px;
    background-color: white;
}

.model-icon-container {
    width: 48px;
    height: 48px;
    min-width: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background-color: rgb(241, 246, 255);
}

.model-icon {
    width: 25px;
    height: 25px;
    background-image: url("project://database/Assets/UI/Images/Icons/atom.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.model-information {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 12px;
    margin-right: 8px;
}

.model-title {
    width: 100%;
    color: rgb(20, 38, 74);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    overflow: hidden;
}

.model-context {
    width: 100%;
    margin-top: 3px;
    color: rgb(108, 124, 155);
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.model-launch-badge {
    align-self: flex-start;
    margin-top: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 9px;
    background-color: rgb(234, 242, 255);
    color: rgb(25, 89, 203);
    font-size: 9px;
    -unity-font-style: bold;
}

.model-card-arrow {
    width: 18px;
    min-width: 18px;
    flex-shrink: 0;
    color: rgb(72, 99, 145);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.labs-status-card {
    width: 100%;
    min-height: 130px;
    padding: 22px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgb(222, 229, 241);
    border-radius: 15px;
    background-color: white;
}

.labs-status-title {
    color: rgb(20, 38, 74);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.labs-status-description {
    margin-top: 7px;
    color: rgb(108, 124, 155);
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.labs-error-state {
    border-color: rgb(244, 190, 194);
    background-color: rgb(255, 248, 249);
}

.labs-retry-button {
    height: 34px;
    margin-top: 12px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 0;
    border-radius: 10px;
    background-color: rgb(25, 91, 207);
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
}

/* =========================================================
   ROLE-BASED VISIBILITY
   ========================================================= */

/* Student chỉ được xem nội dung, không thấy các control quản trị. */
.role-student .reorder-preview,
.role-student .add-chapter-card,
.role-student .edit-content-button,
.role-student .chapter-edit-actions,
.role-student .lesson-edit-actions,
.role-student .add-lesson-button,
.role-student .drag-icon,
.role-student .lesson-drag-icon,
.role-student .more-button {
    display: none;
}

/* Lesson vẫn có thể nhấn để mở ShowLessonScene. */
.role-student .lesson-row {
    cursor: link;
}

/* Khi bỏ drag handle, giữ nội dung chapter/lesson căn đều. */
.role-student .chapter-header-row,
.role-student .lesson-row {
    padding-left: 12px;
}



/* =========================================================
   STUDENT LIST
   ========================================================= */

.student-list-content {
    width: 100%;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 24px;
    flex-direction: column;
}

.student-list-heading {
    width: 100%;
    min-height: 26px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.student-list-count-label {
    font-size: 11px;
    color: rgb(91, 105, 132);
    -unity-font-style: bold;
}

.student-online-summary {
    flex-direction: row;
    align-items: center;
}

.student-online-summary-dot {
    width: 6px;
    height: 6px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: rgb(29, 201, 93);
}

.student-online-count-label {
    font-size: 10px;
    color: rgb(29, 179, 83);
    -unity-font-style: bold;
}

.student-card-list {
    width: 100%;
    flex-direction: column;
}

.student-card {
    width: 100%;
    min-height: 76px;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgb(225, 231, 241);
    border-radius: 14px;
    background-color: white;
}

.student-avatar-wrap {
    width: 43px;
    height: 43px;
    min-width: 43px;
    min-height: 43px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
}

.student-avatar {
    width: 43px;
    height: 43px;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background-color: rgb(17, 83, 195);
}

.student-avatar-initials {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.student-presence-dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 11px;
    height: 11px;
    border-width: 2px;
    border-color: white;
    border-radius: 6px;
    background-color: rgb(160, 170, 189);
}

.student-presence-dot-online {
    background-color: rgb(29, 201, 93);
}

.student-information {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.student-name-label {
    font-size: 13px;
    color: rgb(18, 40, 78);
    -unity-font-style: bold;
    white-space: normal;
}

.student-last-active-label {
    margin-top: 1px;
    font-size: 9px;
    color: rgb(126, 139, 162);
}

.student-enrollment-label {
    margin-top: 4px;
    font-size: 9px;
    color: rgb(25, 91, 207);
    -unity-font-style: bold;
}

.student-message-button {
    position: relative;
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    margin-left: 8px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 17px;
    background-color: rgb(242, 247, 255);
}


/* Unread count for exactly the student who sent messages to this teacher. */
.student-message-unread-badge {
    position: absolute;
    right: -5px;
    top: -6px;

    min-width: 17px;
    height: 17px;
    padding-left: 4px;
    padding-right: 4px;

    align-items: center;
    justify-content: center;

    border-width: 2px;
    border-color: white;
    border-radius: 9px;

    background-color: rgb(235, 66, 66);
    color: white;

    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.student-message-icon {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/UI/Images/Icons/message.png");
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}

.student-list-state {
    min-height: 160px;
    align-items: center;
    justify-content: center;
}

.student-list-state-title {
    font-size: 13px;
    color: rgb(31, 51, 88);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.student-list-state-description {
    max-width: 250px;
    margin-top: 6px;
    font-size: 10px;
    color: rgb(126, 139, 162);
    white-space: normal;
    -unity-text-align: middle-center;
}

.student-list-error-label {
    color: rgb(190, 49, 68);
}

.student-list-retry-button {
    height: 34px;
    margin-top: 10px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 0;
    border-radius: 17px;
    background-color: rgb(25, 91, 207);
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
}
