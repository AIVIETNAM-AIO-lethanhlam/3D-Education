.privacy-page-root {
    flex-grow: 1;
    flex-direction: column;

    background-color: rgb(247, 249, 253);
    color: rgb(16, 34, 73);

    -unity-font-definition:
        resource("Fonts/Inter_24pt-Regular");
}

/* =========================================================
   SCROLL VIEW
   ========================================================= */

.privacy-scroll {
    flex-grow: 1;
}

.privacy-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    min-height: 100%;
}

.privacy-scroll .unity-scroller,
.privacy-scroll .unity-scroll-view__vertical-scroller,
.privacy-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
}

.privacy-scroll .unity-scroll-view__content-viewport {
    margin-right: 0;
    margin-bottom: 0;
}

.privacy-content {
    padding-top: 18px;
    padding-right: 18px;
    padding-left: 18px;
}

/* =========================================================
   INTRO CARD
   ========================================================= */

.privacy-intro-card {
    margin-bottom: 16px;

    padding-top: 18px;
    padding-right: 17px;
    padding-bottom: 18px;
    padding-left: 17px;

    background-color: rgb(236, 242, 251);

    border-width: 1px;
    border-color: rgb(177, 198, 232);
    border-radius: 18px;
}

.privacy-intro-text {
    margin: 0;
    padding: 0;

    font-size: 15px;
    line-height: 22px;

    color: rgb(25, 45, 84);

    white-space: normal;
    -unity-text-align: upper-left;
}

/* =========================================================
   ACCORDION
   ========================================================= */

.privacy-section {
    margin-bottom: 12px;

    background-color: rgb(255, 255, 255);

    border-width: 1px;
    border-color: rgb(216, 225, 240);
    border-radius: 17px;

    overflow: hidden;
}

.privacy-section-header {
    width: 100%;
    min-height: 58px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    margin: 0;
    padding-top: 0;
    padding-right: 14px;
    padding-bottom: 0;
    padding-left: 16px;

    background-color: rgba(255, 255, 255, 0);

    border-width: 0;
    border-radius: 0;
}

.privacy-section-title {
    flex-grow: 1;

    margin: 0;
    padding: 0;

    font-size: 15px;
    -unity-font-style: bold;

    color: rgb(10, 31, 70);
    -unity-text-align: middle-left;

    white-space: normal;
}

.privacy-section-arrow {
    width: 32px;
    height: 32px;

    flex-grow: 0;
    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    margin-left: 10px;
    padding: 0;

    background-color: rgb(238, 244, 253);
    border-radius: 16px;
}

.privacy-section-arrow-icon {
    width: 14px;
    height: 14px;

    background-image: url("project://database/Assets/UI/Images/Icons/arrow-down.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(83, 105, 147);
}

/* Open section: only the icon changes to arrow-up.png and the
   circle turns a slightly darker grey (icon stays visible). */
.privacy-section-arrow--expanded {
    background-color: rgb(214, 222, 235);
}

.privacy-section-arrow--expanded .privacy-section-arrow-icon {
    background-image: url("project://database/Assets/UI/Images/Icons/arrow-up.png");
    -unity-background-image-tint-color: rgb(55, 75, 115);
}

.privacy-section-content {
    padding-top: 12px;
    padding-right: 17px;
    padding-bottom: 16px;
    padding-left: 17px;

    border-top-width: 1px;
    border-top-color: rgb(222, 229, 241);
}

.privacy-section-content-hidden {
    display: none;
}

.privacy-section-body {
    margin: 0;
    padding: 0;

    font-size: 14px;
    line-height: 21px;

    color: rgb(92, 107, 142);

    white-space: normal;
    -unity-text-align: upper-left;
}

.privacy-scroll-bottom-space {
    height: 20px;
}

/* =========================================================
   CONSENT PANEL
   Raised card above the bottom edge. The controller adds the
   device safe-area inset (gesture bar) to padding-bottom.
   ========================================================= */

.privacy-consent-panel {
    flex-shrink: 0;

    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 28px;
    padding-left: 20px;

    background-color: rgb(255, 255, 255);

    border-top-width: 1px;
    border-top-color: rgb(216, 225, 240);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
}

.privacy-consent-row {
    flex-direction: row;
    align-items: center;

    margin-bottom: 14px;
    padding-top: 10px;
    padding-right: 14px;
    padding-bottom: 10px;
    padding-left: 14px;

    background-color: rgb(244, 247, 252);

    border-width: 1px;
    border-color: rgb(222, 229, 241);
    border-radius: 14px;
}

.privacy-consent-toggle {
    flex-grow: 1;
    flex-shrink: 1;

    margin: 0;
    padding: 0;

    font-size: 14px;
    -unity-font-style: bold;

    color: rgb(28, 46, 84);
}

.privacy-consent-toggle .unity-toggle__input {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
}

.privacy-consent-toggle .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    min-width: 24px;

    flex-shrink: 0;

    margin-right: 12px;

    background-color: rgb(255, 255, 255);

    border-width: 2px;
    border-color: rgb(177, 193, 220);
    border-radius: 12px;
}

.privacy-consent-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(0, 70, 180);
    border-color: rgb(0, 70, 180);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.privacy-consent-toggle .unity-toggle__text {
    flex-shrink: 1;

    margin: 0;

    font-size: 14px;
    color: rgb(28, 46, 84);

    white-space: normal;
}

.accept-continue-button {
    width: 100%;
    height: 52px;

    margin: 0;
    padding: 0;

    background-color: rgb(0, 70, 180);

    border-width: 0;
    border-radius: 26px;

    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.accept-continue-button:disabled {
    background-color: rgb(228, 233, 242);
    color: rgb(150, 160, 181);
    opacity: 1;
}

/* =========================================================
   INTERACTION
   ========================================================= */

.privacy-section-header:hover {
    background-color: rgb(249, 251, 255);
}

.privacy-section-header:active {
    opacity: 0.74;
}

.accept-continue-button:hover:enabled {
    opacity: 0.9;
}

.accept-continue-button:active:enabled {
    opacity: 0.72;
}

/* =========================================================
   HEADER (PrivacyScene only - class added by the controller)
   Smaller title that can wrap to 2 lines; the 2 lines stay
   within the 42px height of the back button and are centred
   with it.
   ========================================================= */

.privacy-header .page-header-layout {
    align-items: center;
}

.privacy-header .page-header-information {
    min-height: 42px;
    justify-content: center;
}

.privacy-header .header-page-title-label {
    font-size: 16px;
    white-space: normal;
    overflow: visible;
    -unity-text-align: middle-left;
    -unity-paragraph-spacing: 0;
}

.privacy-header .header-subtitle-container {
    display: none;
}
